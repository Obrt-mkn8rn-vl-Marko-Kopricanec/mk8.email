#!/bin/sh
set -eu

if [ "$(id -u)" -ne 0 ] || [ "$#" -ne 1 ]; then
    printf '%s\n' "Usage: install-host-hardening ASSET_ROOT" >&2
    exit 2
fi

for command_name in aide auditctl debsums s-nail smartctl; do
    if ! command -v "$command_name" >/dev/null 2>&1; then
        printf '%s\n' "A required host security command is missing: $command_name" >&2
        exit 1
    fi
done

asset_root=$1
if [ ! -d "$asset_root/deploy" ]; then
    printf '%s\n' "The deployment asset root is not valid." >&2
    exit 1
fi

install -m 0644 "$asset_root/deploy/apt/20auto-upgrades" /etc/apt/apt.conf.d/20auto-upgrades
install -m 0644 "$asset_root/deploy/apt/52mk8-unattended-upgrades" /etc/apt/apt.conf.d/52mk8-unattended-upgrades
install -m 0640 "$asset_root/deploy/audit/50-mk8-server.rules" /etc/audit/rules.d/50-mk8-server.rules
install -m 0644 "$asset_root/deploy/aide/90_mk8_dynamic_data" /etc/aide/aide.conf.d/90_mk8_dynamic_data
install -m 0644 "$asset_root/deploy/default/debsums" /etc/default/debsums
install -m 0644 "$asset_root/deploy/default/aide" /etc/default/aide
install -m 0644 "$asset_root/deploy/default/sysstat" /etc/default/sysstat
install -m 0644 "$asset_root/deploy/fail2ban/90-mk8-server.local" /etc/fail2ban/jail.d/90-mk8-server.local
install -d -o root -g root -m 0755 /etc/systemd/coredump.conf.d
install -m 0644 "$asset_root/deploy/coredump/90-mk8-server.conf" /etc/systemd/coredump.conf.d/90-mk8-server.conf
install -m 0644 "$asset_root/deploy/journald/90-mk8-server.conf" /etc/systemd/journald.conf.d/90-mk8-server.conf
install -m 0644 "$asset_root/deploy/logind/90-mk8-server.conf" /etc/systemd/logind.conf.d/90-mk8-server.conf
install -m 0644 "$asset_root/deploy/modprobe/90-mk8-server.conf" /etc/modprobe.d/90-mk8-server.conf
install -m 0644 "$asset_root/deploy/pam/90-mk8-server.conf" /etc/security/pwquality.conf.d/90-mk8-server.conf
install -m 0644 "$asset_root/deploy/profile/90-mk8-umask.sh" /etc/profile.d/90-mk8-umask.sh
install -d -o postgres -g postgres -m 0750 /etc/postgresql/17/main/conf.d
if [ -L /etc/postgresql/17/main/pg_hba.local.conf ] \
    || { [ -e /etc/postgresql/17/main/pg_hba.local.conf ] \
        && [ ! -f /etc/postgresql/17/main/pg_hba.local.conf ]; }; then
    printf '%s\n' "The local PostgreSQL access file is not safe." >&2
    exit 1
fi
if [ -f /etc/postgresql/17/main/pg_hba.local.conf ]; then
    [ "$(stat -c '%U:%G %a %h' /etc/postgresql/17/main/pg_hba.local.conf)" \
        = "root:postgres 640 1" ] || {
        printf '%s\n' "The local PostgreSQL access file has unsafe metadata." >&2
        exit 1
    }
fi
install -o postgres -g postgres -m 0640 "$asset_root/deploy/postgresql/90-mk8-production.conf" /etc/postgresql/17/main/conf.d/90-mk8-production.conf
install -o postgres -g postgres -m 0640 "$asset_root/deploy/postgresql/pg_hba.conf" /etc/postgresql/17/main/pg_hba.conf
install -m 0600 "$asset_root/deploy/ssh/90-mk8-hardening.conf" /etc/ssh/sshd_config.d/90-mk8-hardening.conf
install -m 0644 "$asset_root/deploy/sysctl/90-mk8-server.conf" /etc/sysctl.d/90-mk8-server.conf
install -m 0644 "$asset_root/deploy/tmpfiles/mk8-postgresql.conf" /etc/tmpfiles.d/mk8-postgresql.conf
install -d -o root -g root -m 0755 /etc/nftables.d
if [ -L /etc/nftables.d/90-local-services.nft ] \
    || { [ -e /etc/nftables.d/90-local-services.nft ] \
        && [ ! -f /etc/nftables.d/90-local-services.nft ]; }; then
    printf '%s\n' "The local firewall file is not safe." >&2
    exit 1
fi
if [ ! -e /etc/nftables.d/90-local-services.nft ]; then
    install -o root -g root -m 0600 /dev/null \
        /etc/nftables.d/90-local-services.nft
fi
[ "$(stat -c '%U:%G %a %h' /etc/nftables.d/90-local-services.nft)" \
    = "root:root 600 1" ] || {
    printf '%s\n' "The local firewall file has unsafe metadata." >&2
    exit 1
}
install -m 0755 "$asset_root/deploy/nftables/mk8-server.nft" /etc/nftables.conf
install -d -o root -g root -m 0755 /etc/systemd/system/dailyaidecheck.service.d
install -m 0644 "$asset_root/deploy/systemd/dailyaidecheck.service.d/90-mk8-hardening.conf" \
    /etc/systemd/system/dailyaidecheck.service.d/90-mk8-hardening.conf
install -d -o root -g root -m 0755 /etc/systemd/system/dailyaidecheck.timer.d
install -m 0644 "$asset_root/deploy/systemd/dailyaidecheck.timer.d/90-mk8-schedule.conf" \
    /etc/systemd/system/dailyaidecheck.timer.d/90-mk8-schedule.conf

if grep -Eq '^[[:space:]]*UMASK[[:space:]]+' /etc/login.defs; then
    sed -i -E 's/^[[:space:]]*UMASK[[:space:]]+.*/UMASK 027/' /etc/login.defs
else
    printf '%s\n' 'UMASK 027' >> /etc/login.defs
fi

sshd -t
nft -c -f /etc/nftables.conf
nft -f /etc/nftables.conf
sysctl --system >/dev/null
systemd-tmpfiles --create /etc/tmpfiles.d/mk8-postgresql.conf
pg_ctlcluster 17 main reload
augenrules --load
aide --config=/etc/aide/aide.conf --config-check
systemctl daemon-reload
systemd-analyze verify dailyaidecheck.service dailyaidecheck.timer
systemctl set-default multi-user.target
systemctl disable --now sddm.service
systemctl mask sleep.target suspend.target hibernate.target hybrid-sleep.target
systemctl mask --now avahi-daemon.service avahi-daemon.socket bluetooth.service \
    cups-browsed.service cups.path cups.service cups.socket
systemctl mask drkonqi-coredump-processor@.service
systemctl enable --now apparmor.service nftables.service auditd.service fail2ban.service \
    acct.service cron.service smartmontools.service sysstat.service \
    unattended-upgrades.service
systemctl enable --now dailyaidecheck.timer sysstat-collect.timer sysstat-summary.timer
systemctl reload ssh.service
systemctl restart fail2ban.service
sh "$asset_root/deploy/tests/host_hardening_smoke"

printf '%s\n' "Host hardening assets installed. Reboot the host to apply all controls."

<?xml version="1.0" encoding="UTF-8"?>
<clientConfig version="1.2">
  <emailProvider id="@@DOMAIN@@">
    <domain>@@DOMAIN@@</domain>
    <displayName>@@DOMAIN@@ Mail</displayName>
    <displayShortName>@@DOMAIN@@</displayShortName>
    <oAuth2>
      <issuer>https://@@CANONICAL_MAIL_HOST@@</issuer>
      <scope>openid profile email offline_access imap smtp pop jmap dav sieve</scope>
      <authURL>https://@@CANONICAL_MAIL_HOST@@/oauth/authorize</authURL>
      <tokenURL>https://@@CANONICAL_MAIL_HOST@@/oauth/token</tokenURL>
      <clientID>thunderbird</clientID>
    </oAuth2>
    <incomingServer type="jmap">
      <url>https://@@CANONICAL_MAIL_HOST@@/.well-known/jmap</url>
      <authentication>OAuth2</authentication>
      <authentication system="http">Basic</authentication>
      <username>%EMAILADDRESS%</username>
    </incomingServer>
    <incomingServer type="imap">
      <hostname>@@CANONICAL_MAIL_HOST@@</hostname>
      <port>993</port>
      <socketType>SSL</socketType>
      <authentication>OAuth2</authentication>
      <authentication>password-cleartext</authentication>
      <username>%EMAILADDRESS%</username>
    </incomingServer>
    <incomingServer type="pop3">
      <hostname>@@CANONICAL_MAIL_HOST@@</hostname>
      <port>995</port>
      <socketType>SSL</socketType>
      <authentication>OAuth2</authentication>
      <authentication>password-cleartext</authentication>
      <username>%EMAILADDRESS%</username>
    </incomingServer>
    <outgoingServer type="smtp">
      <hostname>@@CANONICAL_MAIL_HOST@@</hostname>
      <port>587</port>
      <socketType>STARTTLS</socketType>
      <authentication>OAuth2</authentication>
      <authentication>password-cleartext</authentication>
      <username>%EMAILADDRESS%</username>
    </outgoingServer>
  </emailProvider>
  <calendar type="caldav">
    <url>https://@@CANONICAL_MAIL_HOST@@/.well-known/caldav</url>
    <authentication>OAuth2</authentication>
    <authentication system="http">Basic</authentication>
    <username>%EMAILADDRESS%</username>
  </calendar>
  <addressbook type="carddav">
    <url>https://@@CANONICAL_MAIL_HOST@@/.well-known/carddav</url>
    <authentication>OAuth2</authentication>
    <authentication system="http">Basic</authentication>
    <username>%EMAILADDRESS%</username>
  </addressbook>
</clientConfig>

#!/bin/sh
set -eu

if [ "$#" -ne 1 ]; then
    printf '%s\n' "Usage: upgrade_distributed_role_smoke UPGRADE_SCRIPT" >&2
    exit 2
fi

upgrade_source=$1
fixture_root=$(dirname -- "$0")/fixtures
test_owner=$(id -un)
test_group=$(id -gn)
test_root=$(mktemp -d /tmp/mk8-upgrade-smoke.XXXXXX)
cleanup() {
    case "$test_root" in
        /tmp/mk8-upgrade-smoke.??????)
            find "$test_root" -type d -exec chmod u+w {} +
            rm -r -- "$test_root"
            ;;
    esac
}
trap cleanup EXIT HUP INT TERM

old_id=aaaaaaaaaaaaaaaa
new_id=bbbbbbbbbbbbbbbb

prepare_case() {
    case_name=$1
    selected_unit=$2
    selected_executable=$3
    state=$test_root/$case_name
    install -d -m 0700 "$state" "$state/mock" "$state/run/lock" \
        "$state/etc/mk8email" "$state/opt/mk8email/releases/$old_id" \
        "$state/opt/mk8email/releases/$new_id"
    install -m 0755 "$fixture_root/upgrade-systemctl" "$state/mock/systemctl"
    install -m 0755 "$fixture_root/upgrade-runuser" "$state/mock/runuser"
    install -m 0755 "$fixture_root/upgrade-curl" "$state/mock/curl"
    : > "$state/mock/dotnet"
    chmod 0755 "$state/mock/dotnet"
    ln -s /bin/true "$state/mock/sleep"

    for release_id in "$old_id" "$new_id"; do
        release=$state/opt/mk8email/releases/$release_id
        install -d -m 0755 "$release/cli" "$release/$(dirname "$selected_executable")"
        : > "$release/cli/mk8.email.Application.CLI.dll"
        : > "$release/$selected_executable"
        if [ "$selected_unit" = mk8email-worker.path ]; then
            install -d -m 0755 "$release/wake"
            : > "$release/wake/mk8.email.Wake.dll"
        fi
        printf 'release_id=%s\n' "$release_id" > "$release/.mk8email-release"
        find "$release" -type f -exec chmod 0444 {} +
        find "$release" -type d -exec chmod 0555 {} +
    done
    ln -s "$state/opt/mk8email/releases/$old_id" "$state/opt/mk8email/current"
    : > "$state/etc/mk8email/distributed-ready"
    chmod 0600 "$state/etc/mk8email/distributed-ready"
    case "$selected_unit" in
        mk8email-gateway.service) role=gateway ;;
        mk8email-worker.path) role=worker ;;
        *) exit 1 ;;
    esac
    : > "$state/etc/mk8email/mk8email.$role.config.json"
    chmod 0640 "$state/etc/mk8email/mk8email.$role.config.json"
    if [ "$role" = worker ]; then
        : > "$state/etc/mk8email/mk8email.wake.connection"
        chmod 0640 "$state/etc/mk8email/mk8email.wake.connection"
        : > "$state/wake_active"
        : > "$state/maintenance_active"
        install -d -m 0700 "$state/run/mk8email-wake"
    fi
    : > "$state/active"
    : > "$state/events"

    # The test copy keeps this literal root check as a sed search pattern.
    # shellcheck disable=SC2016
    sed \
        -e 's@if \[ "$(id -u)" -ne 0 \] || \[ "$#" -ne 2 \]; then@if [ "$#" -ne 2 ]; then@' \
        -e "s|/opt/mk8email|$state/opt/mk8email|g" \
        -e "s|/etc/mk8email|$state/etc/mk8email|g" \
        -e "s|/run/lock|$state/run/lock|g" \
        -e "s|/run/mk8email-wake|$state/run/mk8email-wake|g" \
        -e "s|/usr/bin/dotnet|$state/mock/dotnet|g" \
        -e "s|root:mk8email 640 1|root:root 640 1|g" \
        -e "s|root:mk8wake 640 1|root:root 640 1|g" \
        -e "s|root:root|$test_owner:$test_group|g" \
        -e "s|-user root|-user $test_owner|g" \
        -e "s|PATH=/usr/sbin:/usr/bin:/sbin:/bin|PATH=$state/mock:/usr/sbin:/usr/bin:/sbin:/bin|g" \
        "$upgrade_source" > "$state/upgrade"
    chmod 0755 "$state/upgrade"
    MK8_UPGRADE_SMOKE_STATE=$state
    MK8_UPGRADE_SMOKE_UNIT=$selected_unit
    export MK8_UPGRADE_SMOKE_STATE MK8_UPGRADE_SMOKE_UNIT
}

prepare_case gateway_success mk8email-gateway.service admin/mk8.email.Gateway.dll
sh "$state/upgrade" gateway "$new_id" >/dev/null
test "$(readlink -f "$state/opt/mk8email/current")" \
    = "$state/opt/mk8email/releases/$new_id"
test -f "$state/active"
grep -Fx 'cli:--probe-gateway-backends' "$state/events" >/dev/null
grep -Fx 'cli:--healthcheck-gateway' "$state/events" >/dev/null

prepare_case gateway_preflight mk8email-gateway.service admin/mk8.email.Gateway.dll
: > "$state/fail_preflight"
if sh "$state/upgrade" gateway "$new_id" >/dev/null 2>&1; then
    printf '%s\n' "The role switched after failed backend preflight." >&2
    exit 1
fi
test "$(readlink -f "$state/opt/mk8email/current")" \
    = "$state/opt/mk8email/releases/$old_id"
test -f "$state/active"
if grep -Fx stop "$state/events" >/dev/null; then
    printf '%s\n' "The role stopped after failed backend preflight." >&2
    exit 1
fi

prepare_case gateway_rollback mk8email-gateway.service admin/mk8.email.Gateway.dll
: > "$state/fail_new_start"
if sh "$state/upgrade" gateway "$new_id" >/dev/null 2>&1; then
    printf '%s\n' "The role reported success after failed startup." >&2
    exit 1
fi
test "$(readlink -f "$state/opt/mk8email/current")" \
    = "$state/opt/mk8email/releases/$old_id"
test -f "$state/active"
test "$(grep -cx stop "$state/events")" -eq 2
test "$(grep -cx start "$state/events")" -eq 2

prepare_case gateway_health_rollback mk8email-gateway.service admin/mk8.email.Gateway.dll
: > "$state/fail_new_health"
if sh "$state/upgrade" gateway "$new_id" >/dev/null 2>&1; then
    printf '%s\n' "The role reported success after failed health checks." >&2
    exit 1
fi
test "$(readlink -f "$state/opt/mk8email/current")" \
    = "$state/opt/mk8email/releases/$old_id"
test -f "$state/active"
test "$(grep -cx stop "$state/events")" -eq 2
test "$(grep -cx start "$state/events")" -eq 2

prepare_case shared_host_refusal mk8email-gateway.service admin/mk8.email.Gateway.dll
: > "$state/other_enabled"
if sh "$state/upgrade" gateway "$new_id" >/dev/null 2>&1; then
    printf '%s\n' "The upgrade accepted a host with both roles enabled." >&2
    exit 1
fi
test "$(readlink -f "$state/opt/mk8email/current")" \
    = "$state/opt/mk8email/releases/$old_id"
test -f "$state/active"
test ! -s "$state/events"

prepare_case worker_success mk8email-worker.path worker/mk8.email.Application.Worker.dll
sh "$state/upgrade" worker "$new_id" >/dev/null
test "$(readlink -f "$state/opt/mk8email/current")" \
    = "$state/opt/mk8email/releases/$new_id"
test -f "$state/active"
test -f "$state/wake_active"
test -f "$state/maintenance_active"
grep -Fx 'cli:--probe-worker-backends' "$state/events" >/dev/null
grep -Fx 'cli:--probe-worker-dispatch' "$state/events" >/dev/null
grep -Fx 'wake:--probe' "$state/events" >/dev/null

prepare_case worker_wake_preflight mk8email-worker.path worker/mk8.email.Application.Worker.dll
: > "$state/fail_wake_preflight"
if sh "$state/upgrade" worker "$new_id" >/dev/null 2>&1; then
    printf '%s\n' "The Worker switched after failed Wake preflight." >&2
    exit 1
fi
test "$(readlink -f "$state/opt/mk8email/current")" \
    = "$state/opt/mk8email/releases/$old_id"
test -f "$state/active"
test -f "$state/wake_active"
test -f "$state/maintenance_active"
if grep -Fx stop "$state/events" >/dev/null; then
    printf '%s\n' "The Worker path stopped after failed Wake preflight." >&2
    exit 1
fi

prepare_case worker_rollback mk8email-worker.path worker/mk8.email.Application.Worker.dll
: > "$state/fail_new_start"
if sh "$state/upgrade" worker "$new_id" >/dev/null 2>&1; then
    printf '%s\n' "The on-demand Worker accepted a failed path start." >&2
    exit 1
fi
test "$(readlink -f "$state/opt/mk8email/current")" \
    = "$state/opt/mk8email/releases/$old_id"
test -f "$state/active"
test -f "$state/wake_active"
test -f "$state/maintenance_active"
test "$(grep -cx stop "$state/events")" -eq 2
test "$(grep -cx stop_wake "$state/events")" -eq 2

prepare_case worker_health_rollback mk8email-worker.path worker/mk8.email.Application.Worker.dll
: > "$state/fail_new_health"
if sh "$state/upgrade" worker "$new_id" >/dev/null 2>&1; then
    printf '%s\n' "The on-demand Worker accepted failed dispatch health." >&2
    exit 1
fi
test "$(readlink -f "$state/opt/mk8email/current")" \
    = "$state/opt/mk8email/releases/$old_id"
test -f "$state/active"
test -f "$state/wake_active"
test -f "$state/maintenance_active"

prepare_case worker_wake_health_rollback mk8email-worker.path worker/mk8.email.Application.Worker.dll
: > "$state/fail_new_wake_health"
if sh "$state/upgrade" worker "$new_id" >/dev/null 2>&1; then
    printf '%s\n' "The on-demand Worker accepted failed Wake health." >&2
    exit 1
fi
test "$(readlink -f "$state/opt/mk8email/current")" \
    = "$state/opt/mk8email/releases/$old_id"
test -f "$state/active"
test -f "$state/wake_active"
test -f "$state/maintenance_active"

printf '%s\n' "Distributed role upgrade and rollback control-flow smoke passed."

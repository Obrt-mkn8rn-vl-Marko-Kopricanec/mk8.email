@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Change password";
}

<section class="panel narrow">
    <h1>Change password</h1>
    <p>Account: <strong>@Model.Address</strong></p>
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="validation"></div>
        <input type="hidden" asp-for="Input.UserId" />
        <label asp-for="Input.Password"></label>
        <input asp-for="Input.Password" autocomplete="new-password" />
        <span asp-validation-for="Input.Password" class="validation"></span>
        <button type="submit">Change password</button>
    </form>
</section>

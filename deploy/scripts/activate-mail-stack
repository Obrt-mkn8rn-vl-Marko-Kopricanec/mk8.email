#!/bin/sh
set -eu

if [ "$(id -u)" -ne 0 ]; then
    printf '%s\n' "Run this command as root." >&2
    exit 2
fi

fail() {
    printf '%s\n' "$1" >&2
    exit 1
}

if systemctl is-active --quiet mk8email-gateway.service \
    || systemctl is-active --quiet mk8email-worker.service \
    || systemctl is-active --quiet mk8email-worker-drain.service \
    || systemctl is-active --quiet mk8email-worker.path \
    || systemctl is-active --quiet mk8email-wake.service; then
    fail "The distributed mail stack is already active; use a controlled upgrade procedure."
fi

/usr/local/sbin/verify-host-prerequisites

test -f /etc/mk8email/schema-ready
marker=/etc/mk8email/distributed-ready
if [ -L "$marker" ] || [ ! -f "$marker" ] \
    || [ "$(stat -c '%U:%G %a %h' "$marker" 2>/dev/null || true)" != 'root:root 600 1' ]; then
    fail "The distributed readiness marker is missing or unsafe."
fi
test -s /etc/mk8email/tls/fullchain.pem
test -s /etc/mk8email/tls/privkey.pem
test -s /etc/mk8email/admin-tls/fullchain.pem
test -s /etc/mk8email/admin-tls/privkey.pem
test -s /etc/rspamd/dkim_selectors.map
test -s /etc/rspamd/dkim_paths.map
/usr/local/sbin/mk8-domain rebuild-signing-maps

cli=/opt/mk8email/current/cli/mk8.email.Application.CLI.dll
[ -f "$cli" ] || fail "The management CLI is missing from the current release."
[ -f /opt/mk8email/current/admin/mk8.email.Gateway.dll ] \
    || fail "The Gateway executable is missing from the current release."
[ -f /opt/mk8email/current/worker/mk8.email.Application.Worker.dll ] \
    || fail "The Worker executable is missing from the current release."
for role in gateway worker; do
    case "$role" in
        gateway)
            config=/etc/mk8email/mk8email.gateway.config.json
            validate=--validate-gateway-config
            probe=--probe-gateway-backends
            ;;
        worker)
            config=/etc/mk8email/mk8email.worker.config.json
            validate=--validate-worker-config
            probe=--probe-worker-backends
            ;;
    esac
    if [ -L "$config" ] || [ ! -f "$config" ] \
        || [ "$(stat -c '%U:%G %a %h' "$config" 2>/dev/null || true)" != 'root:mk8email 640 1' ]; then
        fail "The $role configuration is missing or has unsafe metadata."
    fi
    timeout 45s runuser -u mk8email -- /usr/bin/dotnet "$cli" "$validate" "$config" \
        || fail "The $role configuration failed validation."
    timeout 45s runuser -u mk8email -- /usr/bin/dotnet "$cli" "$probe" "$config" \
        || fail "The $role distributed backends failed their canary."
done

systemctl stop postfix.service dovecot.service 2>/dev/null || true
systemctl disable postfix.service dovecot.service 2>/dev/null || true
systemctl mask postfix.service dovecot.service
for forbidden_package in \
    postfix postfix-pcre postfix-pgsql \
    dovecot-core dovecot-imapd dovecot-lmtpd dovecot-pgsql dovecot-sieve; do
    if dpkg-query --show --showformat='${db:Status-Abbrev}\n' "$forbidden_package" 2>/dev/null \
        | grep -q '^ii'; then
        fail "A forbidden mail package is installed: $forbidden_package"
    fi
done

/usr/local/sbin/configure-mail-database-access
/usr/local/sbin/mk8email --ensure-runtime-schema
rspamadm configtest --config=/etc/rspamd/rspamd.conf --strict >/dev/null
nginx -t
nft -c -f /etc/nftables.conf

activated=no
cleanup() {
    if [ "$activated" != yes ]; then
        rm -f -- /etc/mk8email/mail-stack-ready
        systemctl stop mk8-mail-health.timer mk8-backup.timer \
            dailyaidecheck.timer 2>/dev/null || true
        systemctl stop mk8email-gateway.service mk8email-worker.path \
            mk8email-worker-drain.service mk8email-wake.service \
            mk8email-worker.service 2>/dev/null || true
        systemctl disable mk8email-gateway.service mk8email-worker.path \
            mk8email-wake.service mk8email-worker.service 2>/dev/null || true
    fi
}
trap cleanup EXIT INT TERM

if ! find /var/lib/clamav -maxdepth 1 -type f \( -name '*.cvd' -o -name '*.cld' \) \
    -print -quit | grep -q .; then
    runuser -u clamav -- freshclam --config-file=/etc/clamav/freshclam.conf --quiet
fi

systemctl enable valkey-server.service clamav-daemon.socket clamav-daemon.service \
    clamav-freshclam.service rspamd.service mk8-mail-health.timer mk8-backup.timer \
    dailyaidecheck.timer
systemctl start valkey-server.service clamav-daemon.socket clamav-daemon.service \
    clamav-freshclam.service rspamd.service
systemctl is-active --quiet valkey-server.service clamav-daemon.service \
    clamav-freshclam.service rspamd.service

systemctl stop mk8email.service mk8email-admin.service 2>/dev/null || true
systemctl disable mk8email.service mk8email-admin.service 2>/dev/null || true
/usr/local/sbin/activate-distributed-role worker
/usr/local/sbin/activate-distributed-role gateway
install -o root -g root -m 0644 /dev/null /etc/mk8email/mail-stack-ready
systemctl start mk8-mail-health.timer mk8-backup.timer dailyaidecheck.timer
systemctl is-active --quiet mk8email-gateway.service mk8email-worker.path \
    mk8email-wake.service rspamd.service
pg_isready --host=127.0.0.1 --port=5432 --dbname=mk8email --quiet
valkey-cli -h 127.0.0.1 -p 6379 ping 2>/dev/null | grep -qx PONG
clamdscan --config-file=/etc/clamav/clamd.conf --ping 1 >/dev/null 2>&1

dashboard_ready=false
for _ in $(seq 1 30); do
    if curl --silent --fail --insecure --max-time 3 --noproxy '*' \
        --resolve admin.mk8n.com:8443:@@MK8_SERVER_IPV4@@ \
        https://admin.mk8n.com:8443/health/ready >/dev/null; then
        dashboard_ready=true
        break
    fi
    sleep 1
done
[ "$dashboard_ready" = true ]

curl --silent --fail --max-time 30 --noproxy '*' \
    --header 'Host: admin.mk8n.com' \
    http://127.0.0.1:8080/health/application >/dev/null \
    || fail "The Gateway could not reach the Application Worker."

if ! /usr/local/sbin/mk8-mail-health --deep --strict; then
    fail "The active mail service failed its operational health check."
fi
systemctl reset-failed mk8-mail-health.service
if ! systemctl start mk8-mail-health.service; then
    fail "The restricted health service could not complete."
fi

if pgrep -x master >/dev/null || pgrep -x dovecot >/dev/null; then
    fail "A forbidden mail process is running."
fi

activated=yes
trap - EXIT INT TERM
printf '%s\n' "The native production mail service is active."

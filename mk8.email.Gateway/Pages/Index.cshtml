@page
@model IndexModel
@{
    ViewData["Title"] = "Status";
}

<h1>Mail service status</h1>
<div class="cards">
    <section class="card">
        <span class="metric">@Model.DomainCount</span>
        <span>Active domains</span>
    </section>
    <section class="card">
        <span class="metric">@Model.ActiveAccountCount</span>
        <span>Active accounts</span>
    </section>
    <section class="card">
        <span class="metric">@Model.CatchAllCount</span>
        <span>Catch-all routes</span>
    </section>
</div>
<section class="panel">
    <div class="title-row">
        <h2>Operational health</h2>
        <span class="health-state @Model.OperationalClass">@Model.OperationalState</span>
    </div>
    <p>Last automated check: @Model.LastCheck</p>
    <div class="cards">
        <div class="card compact">
            <span class="metric">@(Model.SystemStatus.QueueCount?.ToString() ?? "—")</span>
            <span>Queued messages</span>
        </div>
        <div class="card compact">
            <span class="metric">@(Model.SystemStatus.MailStorageUsedPercent is null ? "—" : $"{Model.SystemStatus.MailStorageUsedPercent}%")</span>
            <span>Mail storage used</span>
        </div>
        <div class="card compact">
            <span class="metric small">@IndexModel.FormatAge(Model.SystemStatus.BackupExportAgeSeconds)</span>
            <span>Latest encrypted backup</span>
        </div>
        <div class="card compact">
            <span class="metric small">@IndexModel.FormatAge(Model.SystemStatus.ClamSignatureAgeSeconds)</span>
            <span>ClamAV signature age</span>
        </div>
        <div class="card compact">
            <span class="metric small">@IndexModel.FormatRemaining(Model.SystemStatus.MailCertificateRemainingSeconds)</span>
            <span>Mail certificate remaining</span>
        </div>
        <div class="card compact">
            <span class="metric small">@IndexModel.FormatRemaining(Model.SystemStatus.AdminCertificateRemainingSeconds)</span>
            <span>Administrator certificate remaining</span>
        </div>
    </div>
</section>
<section class="panel">
    <h2>Control boundary</h2>
    <p>mk8.email provides SMTP, message submission, IMAP, mailbox storage, and delivery.</p>
    <p>Rspamd and ClamAV inspect queued messages before delivery.</p>
    <p>This dashboard controls domains and accounts. It does not render message content.</p>
</section>

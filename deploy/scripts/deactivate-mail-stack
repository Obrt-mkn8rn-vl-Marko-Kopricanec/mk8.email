#!/bin/sh
set -eu

if [ "$(id -u)" -ne 0 ]; then
    printf '%s\n' "Run this command as root." >&2
    exit 2
fi

systemctl stop mk8-mail-health.timer mk8-backup.timer dailyaidecheck.timer 2>/dev/null || true
systemctl stop mk8email-gateway.service mk8email-worker.service 2>/dev/null || true
systemctl disable mk8email-gateway.service mk8email-worker.service 2>/dev/null || true
systemctl stop mk8email.service mk8email-admin.service rspamd.service
systemctl stop postfix.service dovecot.service 2>/dev/null || true
systemctl disable postfix.service dovecot.service 2>/dev/null || true
systemctl mask postfix.service dovecot.service
rm -f -- /etc/mk8email/mail-stack-ready
printf '%s\n' "The public mail services are inactive."

#!/bin/sh
set -eu

deep=false
strict=false
for option in "$@"; do
    case "$option" in
        --deep) deep=true ;;
        --strict) strict=true ;;
        *)
            printf '%s\n' "Usage: mk8-mail-health [--deep] [--strict]" >&2
            exit 2
            ;;
    esac
done

state_directory=/var/lib/mk8-mail-health
state_file=$state_directory/status
status_json=$state_directory/status.json
backup_lock=/run/lock/mk8-backup.lock
exec 8>"$backup_lock"
if ! flock --shared --nonblock 8; then
    printf '%s\n' "The mail health check was skipped during a backup."
    exit 0
fi

errors=$(mktemp /run/mk8-mail-health.XXXXXX)
install -d -o root -g mk8email -m 2750 "$state_directory"
status_snapshot=$(mktemp "$state_directory/status.json.XXXXXX")
trap 'rm -f -- "$errors" "$status_snapshot"' EXIT INT TERM

check_epoch=$(date +%s)
queue_count=0
oldest_age=null
used_percent=null
backup_age=null
signature_age=null
mail_certificate_remaining=null
admin_certificate_remaining=null
latest_backup=
latest_export=
latest_export_checksum=
backup_checksum_metadata_valid=false

record_error() {
    printf '%s\n' "$1" >> "$errors"
}

certificate_remaining() {
    certificate_path=$1
    not_after=$(openssl x509 -in "$certificate_path" -noout -enddate 2>/dev/null) || {
        printf '%s\n' null
        return
    }
    expiry_epoch=$(date --date="${not_after#notAfter=}" +%s 2>/dev/null) || {
        printf '%s\n' null
        return
    }
    printf '%s\n' "$((expiry_epoch - check_epoch))"
}

write_status_snapshot() {
    health_state=$1
    checked_at=$(date --utc +%Y-%m-%dT%H:%M:%SZ)
    error_count=$(wc -l < "$errors" | tr -d ' ')
    printf '{"state":"%s","checkedAt":"%s","queueCount":%s,"oldestQueuedMessageSeconds":%s,"mailStorageUsedPercent":%s,"backupExportAgeSeconds":%s,"clamSignatureAgeSeconds":%s,"mailCertificateRemainingSeconds":%s,"adminCertificateRemainingSeconds":%s,"errorCount":%s}\n' \
        "$health_state" "$checked_at" "$queue_count" "$oldest_age" "$used_percent" \
        "$backup_age" "$signature_age" "$mail_certificate_remaining" \
        "$admin_certificate_remaining" "$error_count" > "$status_snapshot"
    chmod 0640 "$status_snapshot"
    mv -f -- "$status_snapshot" "$status_json"
}

for service_name in postgresql.service mk8email.service rspamd.service \
    clamav-daemon.service clamav-freshclam.service valkey-server.service \
    mk8email-admin.service nginx.service nftables.service fail2ban.service \
    auditd.service apparmor.service acct.service cron.service \
    smartmontools.service sysstat.service unattended-upgrades.service \
    mk8-backup.timer mk8-mail-health.timer dailyaidecheck.timer \
    apt-daily.timer apt-daily-upgrade.timer certbot.timer fstrim.timer \
    logrotate.timer sysstat-collect.timer sysstat-summary.timer; do
    systemctl is-active --quiet "$service_name" || record_error "$service_name is not active."
done

for forbidden_service in postfix.service dovecot.service; do
    if systemctl is-active --quiet "$forbidden_service"; then
        record_error "A forbidden mail service is active: $forbidden_service"
    fi
done
for forbidden_package in \
    postfix postfix-pcre postfix-pgsql \
    dovecot-core dovecot-imapd dovecot-lmtpd dovecot-pgsql dovecot-sieve; do
    if dpkg-query --show --showformat='${db:Status-Abbrev}\n' "$forbidden_package" 2>/dev/null \
        | grep -q '^ii'; then
        record_error "A forbidden mail package is installed: $forbidden_package"
    fi
done
if pgrep -x master >/dev/null || pgrep -x dovecot >/dev/null; then
    record_error "A forbidden mail process is running."
fi
if [ -L /dev/null ] || [ ! -c /dev/null ]; then
    record_error "/dev/null is not a direct character device."
elif [ "$(stat -c '%t:%T %U:%G %a %h' /dev/null)" != "1:3 root:root 666 1" ]; then
    record_error "/dev/null has unexpected device metadata."
fi
unexpected_device_name=$(LC_ALL=C find /dev -xdev -mindepth 1 -maxdepth 1 \
    -regextype posix-extended -regex '.*/.*[[:cntrl:]].*' -printf x -quit)
[ -z "$unexpected_device_name" ] \
    || record_error "/dev contains a direct child with control characters in its name."

for completed_service in mk8-backup.service dailyaidecheck.service \
    apt-daily-upgrade.service certbot.service fstrim.service logrotate.service; do
    service_result=$(systemctl show "$completed_service" --property=Result --value 2>/dev/null || true)
    [ "$service_result" = success ] || record_error "$completed_service did not finish successfully."
done
aide_last_exit=$(systemctl show dailyaidecheck.service \
    --property=ExecMainExitTimestampMonotonic --value 2>/dev/null || true)
uptime_seconds=$(cut -d. -f1 /proc/uptime)
case "$aide_last_exit:$uptime_seconds" in
    *[!0-9:]*|:*|*:)
        record_error "The AIDE completion time is not available."
        ;;
    0:*)
        if [ "$uptime_seconds" -gt 129600 ]; then
            record_error "AIDE has not completed during the last 36 hours."
        fi
        ;;
    *)
        aide_last_exit_seconds=$((aide_last_exit / 1000000))
        if [ "$aide_last_exit_seconds" -gt "$uptime_seconds" ] \
            || [ $((uptime_seconds - aide_last_exit_seconds)) -gt 129600 ]; then
            record_error "AIDE has not completed during the last 36 hours."
        fi
        ;;
esac

pg_isready --host=127.0.0.1 --port=5432 --dbname=mk8email --quiet \
    || record_error "PostgreSQL is not ready."
valkey-cli -h 127.0.0.1 -p 6379 ping 2>/dev/null | grep -qx PONG \
    || record_error "Valkey is not ready."
clamdscan --config-file=/etc/clamav/clamd.conf --ping 1 >/dev/null 2>&1 \
    || record_error "ClamAV is not ready."
/usr/local/sbin/mk8email --healthcheck >/dev/null 2>&1 \
    || record_error "A native mail protocol service is not ready."
signature_path=$(find /var/lib/clamav -maxdepth 1 -type f \
    \( -name '*.cvd' -o -name '*.cld' \) -printf '%T@ %p\n' \
    | sort -nr | sed -n '1s/^[^ ]* //p')
if [ -n "$signature_path" ]; then
    signature_epoch=$(stat -c %Y "$signature_path")
    signature_age=$((check_epoch - signature_epoch))
    if [ "$signature_age" -lt 0 ]; then
        signature_age=0
        record_error "A ClamAV signature timestamp is in the future."
    elif [ "$signature_age" -gt 172800 ]; then
        record_error "ClamAV signatures are older than two days."
    fi
else
    record_error "ClamAV signatures are not available."
fi
if [ -s /etc/mk8email/secrets/backup-age-recipient ]; then
    latest_export=$(find /var/backups/mk8-export -maxdepth 1 -type f \
        -name '20??????T??????Z.tar.gz.age' -printf '%T@ %p\n' 2>/dev/null \
        | sort -nr | sed -n '1s/^[^ ]* //p')
    if [ -z "$latest_export" ]; then
        record_error "An encrypted backup export is not available."
    else
        export_name=${latest_export##*/}
        backup_name=${export_name%.tar.gz.age}
        latest_backup=/var/backups/mk8/$backup_name
        latest_export_checksum=$latest_export.sha256
        export_epoch=$(stat -c %Y "$latest_export")
        backup_age=$((check_epoch - export_epoch))
        if [ "$backup_age" -lt 0 ]; then
            backup_age=0
            record_error "The encrypted backup timestamp is in the future."
        elif [ "$backup_age" -gt 172800 ]; then
            record_error "The encrypted backup export is older than two days."
        fi
        if [ ! -d "$latest_backup" ] || [ ! -s "$latest_backup/SHA256SUMS" ]; then
            record_error "The encrypted export does not have a complete local backup."
        elif [ ! -s "$latest_export_checksum" ]; then
            record_error "The encrypted backup checksum is not available."
        else
            checksum_line=$(cat "$latest_export_checksum")
            checksum_digest=${checksum_line%% *}
            checksum_name=${checksum_line#"$checksum_digest  "}
            case "$checksum_digest" in
                ''|*[!0-9a-f]*) ;;
                *)
                    if [ "${#checksum_digest}" -eq 64 ] \
                        && [ "$checksum_name" = "$export_name" ] \
                        && [ "$(wc -l < "$latest_export_checksum" | tr -d ' ')" -eq 1 ]; then
                        backup_checksum_metadata_valid=true
                    fi
                    ;;
            esac
            if [ "$backup_checksum_metadata_valid" != true ]; then
                record_error "The encrypted backup checksum metadata is not valid."
            fi
        fi
    fi
fi

queue_stats=$(runuser -u postgres -- psql --dbname=mk8email --no-psqlrc \
    --tuples-only --no-align --field-separator='|' --set=ON_ERROR_STOP=1 \
    --command="WITH queue AS (
        SELECT
            count(*) FILTER (WHERE state IN ('pending', 'processing')) AS active_count,
            min(received_at) FILTER (WHERE state IN ('pending', 'processing')) AS oldest,
            count(*) FILTER (WHERE state = 'quarantined') AS quarantine_count,
            count(*) FILTER (WHERE state = 'dead') AS dead_count
        FROM mail_queue_messages
    )
    SELECT active_count,
        COALESCE(GREATEST(0, EXTRACT(EPOCH FROM CURRENT_TIMESTAMP - oldest))::bigint::text, 'null'),
        quarantine_count,
        dead_count
    FROM queue" 2>/dev/null) || {
    queue_stats=
    record_error "The native mail queue is not available."
}
if [ -n "$queue_stats" ]; then
    if ! printf '%s\n' "$queue_stats" \
        | grep -Eq '^[0-9]+\|(null|[0-9]+)\|[0-9]+\|[0-9]+$'; then
        queue_count=0
        oldest_age=null
        record_error "The native mail queue returned invalid health data."
    else
        queue_count=$(printf '%s\n' "$queue_stats" | cut -d '|' -f 1)
        oldest_age=$(printf '%s\n' "$queue_stats" | cut -d '|' -f 2)
        quarantine_count=$(printf '%s\n' "$queue_stats" | cut -d '|' -f 3)
        dead_count=$(printf '%s\n' "$queue_stats" | cut -d '|' -f 4)
        [ "$queue_count" -le 100 ] \
            || record_error "The native queue contains more than 100 active messages."
        if [ "$oldest_age" != null ] && [ "$oldest_age" -gt 86400 ]; then
            record_error "The native queue contains an active message older than one day."
        fi
        [ "$quarantine_count" -eq 0 ] \
            || record_error "The native queue contains quarantined messages."
        [ "$dead_count" -eq 0 ] \
            || record_error "The native queue contains dead messages."
    fi
fi

used_percent=$(df -P /var/lib/postgresql 2>/dev/null \
    | awk 'NR == 2 { gsub(/%/, "", $5); print $5 }' || true)
case "$used_percent" in
    ''|*[!0-9]*)
        used_percent=null
        record_error "Mail storage use is not available."
        ;;
    *)
        [ "$used_percent" -lt 90 ] || record_error "Mail storage is at least 90 percent full."
        ;;
esac
backup_used_percent=$(df -P /var/backups 2>/dev/null \
    | awk 'NR == 2 { gsub(/%/, "", $5); print $5 }' || true)
case "$backup_used_percent" in
    ''|*[!0-9]*) record_error "Backup storage use is not available." ;;
    *)
        [ "$backup_used_percent" -lt 90 ] \
            || record_error "Backup storage is at least 90 percent full."
        ;;
esac
inode_used_percent=$(df -Pi /var/lib/postgresql 2>/dev/null \
    | awk 'NR == 2 { gsub(/%/, "", $5); print $5 }' || true)
case "$inode_used_percent" in
    ''|*[!0-9]*) record_error "Mail storage inode use is not available." ;;
    *)
        [ "$inode_used_percent" -lt 90 ] \
            || record_error "Mail storage inode use is at least 90 percent."
        ;;
esac
openssl x509 -in /etc/mk8email/tls/fullchain.pem -noout -checkend 1209600 >/dev/null 2>&1 \
    || record_error "The mail certificate expires within 14 days."
openssl x509 -in /etc/mk8email/tls/fullchain.pem -noout \
    -checkhost email.mk8n.com >/dev/null 2>&1 \
    || record_error "The mail certificate does not cover email.mk8n.com."
openssl x509 -in /etc/mk8email/admin-tls/fullchain.pem -noout -checkend 1209600 >/dev/null 2>&1 \
    || record_error "The administrator certificate expires within 14 days."
openssl x509 -in /etc/mk8email/admin-tls/fullchain.pem -noout \
    -checkhost admin.mk8n.com >/dev/null 2>&1 \
    || record_error "The administrator certificate does not cover admin.mk8n.com."
mail_certificate_remaining=$(certificate_remaining /etc/mk8email/tls/fullchain.pem)
admin_certificate_remaining=$(certificate_remaining /etc/mk8email/admin-tls/fullchain.pem)
curl --silent --fail --insecure --max-time 10 \
    --noproxy '*' \
    --resolve admin.mk8n.com:8443:@@MK8_SERVER_IPV4@@ \
    https://admin.mk8n.com:8443/health/ready >/dev/null \
    || record_error "The administrator dashboard is not ready."

active_domains=$(runuser -u postgres -- psql --dbname=mk8email --no-psqlrc \
    --tuples-only --no-align \
    --command='SELECT a.domain FROM addresses a JOIN companies c ON c.id = a.company_id WHERE a.is_active AND c.is_active ORDER BY a.domain' \
    2>/dev/null) || {
    active_domains=
    record_error "The active domain list is not available."
}
for active_domain in $active_domains; do
    case "$active_domain" in
        *[!a-z0-9.-]*|.*|*..*|*.)
            record_error "An active domain name is not safe."
            continue
            ;;
    esac
    domain_directory=/etc/mk8email/domains/$active_domain
    selector_file=$domain_directory/dkim-selector
    if [ ! -s "$domain_directory/prepared" ] || [ ! -s "$selector_file" ]; then
        record_error "The active domain $active_domain is not prepared."
        continue
    fi
    domain_selector=$(sed -n '1p' "$selector_file")
    case "$domain_selector" in
        ''|*[!a-z0-9]*)
            record_error "The active domain $active_domain has an invalid DKIM selector."
            continue
            ;;
    esac
    domain_key=/etc/mk8email/dkim/$active_domain/$domain_selector.private.pem
    grep -Fx "$active_domain $domain_selector" /etc/rspamd/dkim_selectors.map >/dev/null 2>&1 \
        || record_error "The active domain $active_domain is missing from the selector map."
    grep -Fx "$active_domain $domain_key" /etc/rspamd/dkim_paths.map >/dev/null 2>&1 \
        || record_error "The active domain $active_domain is missing from the key map."
    runuser -u _rspamd -- test -r "$domain_key" \
        || record_error "Rspamd cannot read the signing key for $active_domain."
    domain_certificate=$domain_directory/tls/fullchain.pem
    domain_private_key=$domain_directory/tls/privkey.pem
    openssl x509 -in "$domain_certificate" -noout -checkend 1209600 >/dev/null 2>&1 \
        || record_error "The discovery certificate for $active_domain expires within 14 days."
    openssl pkey -in "$domain_private_key" -noout -check </dev/null >/dev/null 2>&1 \
        || record_error "The discovery private key for $active_domain is not valid."
    for discovery_name in "autoconfig.$active_domain" "mta-sts.$active_domain"; do
        openssl x509 -in "$domain_certificate" -noout \
            -checkhost "$discovery_name" >/dev/null 2>&1 \
            || record_error "The discovery certificate does not cover $discovery_name."
    done
    [ -s "/etc/nginx/mk8email-domains.d/$active_domain.conf" ] \
        || record_error "The nginx configuration for $active_domain is missing."
    curl --silent --fail --insecure --max-time 10 --noproxy '*' \
        --resolve "autoconfig.$active_domain:443:127.0.0.1" \
        "https://autoconfig.$active_domain/mail/config-v1.1.xml" >/dev/null \
        || record_error "The autoconfiguration endpoint for $active_domain is not ready."
    curl --silent --fail --insecure --max-time 10 --noproxy '*' \
        --resolve "mta-sts.$active_domain:443:127.0.0.1" \
        "https://mta-sts.$active_domain/.well-known/mta-sts.txt" >/dev/null \
        || record_error "The MTA-STS endpoint for $active_domain is not ready."
done

current_release=$(readlink -f /opt/mk8email/current 2>/dev/null || true)
case "$current_release" in
    /opt/mk8email/releases/[0-9a-f]*)
        release_id=${current_release##*/}
        provenance=$current_release/.mk8email-release
        if [ ! -f "$provenance" ] || [ -L "$provenance" ]; then
            record_error "The current release provenance is not a regular file."
        elif [ "$(stat -c '%U:%G %a' "$provenance")" != "root:root 444" ]; then
            record_error "The current release provenance has unsafe metadata."
        elif [ "$(wc -l < "$provenance" | tr -d ' ')" -ne 4 ]; then
            record_error "The current release provenance has an invalid structure."
        else
            source_commit=$(sed -n 's/^commit=//p' "$provenance")
            artifact_digest=$(sed -n 's/^artifact_sha256=//p' "$provenance")
            asset_digest=$(sed -n 's/^assets_sha256=//p' "$provenance")
            recorded_release_id=$(sed -n 's/^release_id=//p' "$provenance")
            if [ "${#source_commit}" -ne 40 ] \
                || ! printf '%s\n' "$source_commit" | grep -Eq '^[0-9a-f]{40}$'; then
                record_error "The current release commit is not valid."
            fi
            case "$artifact_digest:$asset_digest" in
                *[!0-9a-f:]*|*:*:*|'':*|*:'')
                    record_error "A current release digest is not valid."
                    ;;
                *)
                    if [ "${#artifact_digest}" -ne 64 ] \
                        || [ "${#asset_digest}" -ne 64 ]; then
                        record_error "A current release digest length is not valid."
                    else
                        expected_release_id=$(printf '%s\n%s\n' \
                            "$artifact_digest" "$asset_digest" \
                            | sha256sum | cut -c1-16)
                        if [ "$recorded_release_id" != "$release_id" ] \
                            || [ "$expected_release_id" != "$release_id" ]; then
                            record_error "The current release provenance does not match its path."
                        fi
                    fi
                    ;;
            esac
        fi
        ;;
    *) record_error "The current release path is not valid." ;;
esac

if [ "$deep" = true ]; then
    if [ -n "$latest_backup" ] && [ -s "$latest_backup/SHA256SUMS" ]; then
        (cd "$latest_backup" && sha256sum --quiet --strict --check SHA256SUMS) \
            || record_error "The latest local backup failed checksum verification."
    fi
    if [ "$backup_checksum_metadata_valid" = true ]; then
        export_root=${latest_export%/*}
        export_checksum_name=${latest_export_checksum##*/}
        (cd "$export_root" \
            && sha256sum --quiet --strict --check "$export_checksum_name") \
            || record_error "The latest encrypted backup failed checksum verification."
    fi
    debsums --silent >/dev/null 2>&1 \
        || record_error "An installed package failed checksum verification."
    logrotate --debug /etc/logrotate.conf >/dev/null 2>&1 \
        || record_error "The log rotation configuration is not valid."
    rspamadm configtest --config=/etc/rspamd/rspamd.conf --strict --quiet >/dev/null 2>&1 \
        || record_error "The Rspamd configuration is not valid."
    clamconf --config-dir=/etc/clamav --non-default >/dev/null 2>&1 \
        || record_error "The ClamAV configuration is not valid."
    nginx -t >/dev/null 2>&1 || record_error "The nginx configuration is not valid."
    nft -c -f /etc/nftables.conf >/dev/null 2>&1 \
        || record_error "The nftables configuration is not valid."
    /usr/local/lib/mk8email/tests/host_hardening_smoke >/dev/null 2>&1 \
        || record_error "The host attack-surface controls are not valid."
    /usr/local/sbin/prune-native-releases --check >/dev/null 2>&1 \
        || record_error "The immutable release retention state is not valid."
    printf 'From: health@localhost\r\nTo: health@localhost\r\nSubject: Health probe\r\n\r\nHealth probe.\r\n' \
        | curl --silent --fail --max-time 10 --noproxy '*' \
            --request POST --header 'Content-Type: message/rfc822' \
            --data-binary @- http://127.0.0.1:11333/checkv2 >/dev/null 2>&1 \
        || record_error "The Rspamd message scanner is not ready."
fi

previous_status=UNKNOWN
previous_key=UNKNOWN
if [ -f "$state_file" ]; then
    previous_status=$(cut -d' ' -f1 "$state_file")
    previous_key=$(cut -d' ' -f1-2 "$state_file")
fi

if [ ! -s "$errors" ]; then
    if [ "$previous_status" != HEALTHY ]; then
        logger --priority=mail.notice --tag=mk8-mail-health "The mail stack recovered."
    fi
    printf 'HEALTHY %s\n' "$(date --utc +%Y-%m-%dT%H:%M:%SZ)" > "$state_file.new"
    mv "$state_file.new" "$state_file"
    write_status_snapshot healthy
    printf '%s\n' "The mail stack is healthy."
    exit 0
fi

error_hash=$(sha256sum "$errors" | cut -d' ' -f1)
current="UNHEALTHY $error_hash"
printf '%s %s\n' "$current" "$(date --utc +%Y-%m-%dT%H:%M:%SZ)" > "$state_file.new"
mv "$state_file.new" "$state_file"
write_status_snapshot unhealthy

if [ "$previous_key" != "$current" ]; then
    summary=$(tr '\n' ' ' < "$errors")
    logger --priority=mail.err --tag=mk8-mail-health -- "$summary"
    cat "$errors" >&2
    exit 1
fi

if [ "$strict" = true ]; then
    cat "$errors" >&2
    exit 1
fi

exit 0

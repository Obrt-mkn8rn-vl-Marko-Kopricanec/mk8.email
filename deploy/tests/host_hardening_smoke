#!/bin/sh
set -eu

if [ "$(id -u)" -ne 0 ] || [ "$#" -ne 0 ]; then
    printf '%s\n' "Usage: host_hardening_smoke" >&2
    exit 2
fi

fail() {
    printf '%s\n' "$1" >&2
    exit 1
}

if [ -L /dev/null ] || [ ! -c /dev/null ]; then
    fail "/dev/null is not a direct character device."
fi
[ "$(stat -c '%t:%T %U:%G %a %h' /dev/null)" = "1:3 root:root 666 1" ] \
    || fail "/dev/null has unexpected device metadata."
unexpected_device_name=$(LC_ALL=C find /dev -xdev -mindepth 1 -maxdepth 1 \
    -regextype posix-extended -regex '.*/.*[[:cntrl:]].*' -printf x -quit)
[ -z "$unexpected_device_name" ] \
    || fail "/dev contains a direct child with control characters in its name."

[ "$(systemctl get-default)" = multi-user.target ] \
    || fail "The default boot target is not multi-user.target."
if [ "$(systemctl is-enabled sddm.service 2>/dev/null || true)" != disabled ]; then
    fail "The graphical login service is not disabled."
fi
if systemctl is-active --quiet sddm.service; then
    fail "The graphical login service is active."
fi

for unit_name in \
    avahi-daemon.service \
    avahi-daemon.socket \
    bluetooth.service \
    cups-browsed.service \
    cups.path \
    cups.service \
    cups.socket \
    drkonqi-coredump-processor@.service; do
    [ "$(systemctl is-enabled "$unit_name" 2>/dev/null || true)" = masked ] \
        || fail "$unit_name is not masked."
    if systemctl is-active --quiet "$unit_name" 2>/dev/null; then
        fail "$unit_name is active."
    fi
done

for forbidden_unit in postfix.service dovecot.service; do
    [ "$(systemctl is-enabled "$forbidden_unit" 2>/dev/null || true)" = masked ] \
        || fail "$forbidden_unit is not masked."
    if systemctl is-active --quiet "$forbidden_unit" 2>/dev/null; then
        fail "$forbidden_unit is active."
    fi
done
for forbidden_package in \
    postfix postfix-pcre postfix-pgsql \
    dovecot-core dovecot-imapd dovecot-lmtpd dovecot-pgsql dovecot-sieve; do
    if dpkg-query --show --showformat='${db:Status-Abbrev}\n' "$forbidden_package" 2>/dev/null \
        | grep -q '^ii'; then
        fail "A forbidden mail package is installed: $forbidden_package"
    fi
done
if pgrep -x master >/dev/null || pgrep -x dovecot >/dev/null; then
    fail "A forbidden mail process is running."
fi

for required_security_unit in apparmor.service auditd.service acct.service \
    cron.service fail2ban.service nftables.service smartmontools.service \
    sysstat.service unattended-upgrades.service; do
    [ "$(systemctl is-enabled "$required_security_unit" 2>/dev/null || true)" = enabled ] \
        || fail "$required_security_unit is not enabled."
    systemctl is-active --quiet "$required_security_unit" \
        || fail "$required_security_unit is not active."
done

mail_required_units=$(systemctl show --property=Requires --value mk8email.service)
case " $mail_required_units " in
    *" postgresql.service "*) ;;
    *) fail "The mail service does not require PostgreSQL." ;;
esac
for scanner_unit in rspamd.service clamav-daemon.service; do
    case " $mail_required_units " in
        *" $scanner_unit "*) fail "The mail service requires $scanner_unit." ;;
    esac
done
mail_wanted_units=$(systemctl show --property=Wants --value mk8email.service)
for wanted_unit in rspamd.service clamav-daemon.service valkey-server.service; do
    case " $mail_wanted_units " in
        *" $wanted_unit "*) ;;
        *) fail "The mail service does not request $wanted_unit." ;;
    esac
done

test -f /etc/fail2ban/filter.d/mk8email-auth.conf \
    || fail "The native mail authentication filter is not installed."
fail2ban-client status mk8email-auth >/dev/null \
    || fail "The native mail authentication jail is not active."

coredump_configuration=$(systemd-analyze cat-config systemd/coredump.conf)
coredump_storage=$(printf '%s\n' "$coredump_configuration" \
    | sed -n 's/^[[:space:]]*Storage=//p' | tail -n 1)
coredump_process_size=$(printf '%s\n' "$coredump_configuration" \
    | sed -n 's/^[[:space:]]*ProcessSizeMax=//p' | tail -n 1)
[ "$coredump_storage" = none ] \
    || fail "Persistent systemd core dumps are not disabled."
[ "$coredump_process_size" = 0 ] \
    || fail "Systemd core dump processing is not disabled."

[ "$(stat -c '%U:%G %a' /etc/systemd/coredump.conf.d/90-mk8-server.conf)" = "root:root 644" ] \
    || fail "The core dump policy has unsafe ownership or permissions."

printf '%s\n' "The host attack-surface checks passed."

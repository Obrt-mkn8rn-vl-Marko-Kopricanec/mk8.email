{
  "Database": {
    "Host": "database",
    "Port": 5432,
    "Name": "mk8email",
    "Username": "mk8email",
    "PasswordFile": "/run/secrets/database_password"
  },
  "Smtp": {
    "Hostname": "email.mk8n.com",
    "Port": 2525,
    "SubmissionPort": 2587,
    "ImplicitTlsPort": 2465,
    "EnableSmtp": true,
    "EnableSubmission": true,
    "EnableImplicitTls": true,
    "EnableStartTls": true,
    "RequireTls": false,
    "RequireAuth": true,
    "AllowRelay": true
  },
  "Imap": {
    "Port": 2143,
    "ImplicitTlsPort": 2993,
    "EnableImap": false,
    "EnableImplicitTls": true
  },
  "Pop3": {
    "Port": 2110,
    "ImplicitTlsPort": 2995,
    "EnablePop3": true,
    "EnableImplicitTls": true,
    "EnableStartTls": true
  },
  "Sieve": {
    "Port": 4190,
    "EnableManageSieve": true,
    "EnableStartTls": true,
    "MaxScriptsPerUser": 64
  },
  "Jmap": {
    "Port": 8081,
    "EnableJmap": true,
    "IsDefault": true,
    "PublicBaseUrl": "https://email.mk8n.com",
    "MaxUploadSizeBytes": 26214400,
    "MaxRequestSizeBytes": 10485760,
    "MaxCallsInRequest": 64,
    "MaxObjectsInGet": 500,
    "MaxObjectsInSet": 500,
    "MaxConcurrentRequests": 8,
    "MaxConcurrentUploads": 4,
    "UploadRetentionHours": 24,
    "MaxUnreferencedBlobBytesPerAccount": 104857600
  },
  "Dav": {
    "EnableDav": true,
    "MaxResourceSizeBytes": 10485760,
    "MaxCollectionsPerUser": 100,
    "MaxResourcesPerCollection": 100000
  },
  "Tls": {
    "CertificatePath": "/run/secrets/tls_certificate",
    "CertificateKeyPath": "/run/secrets/tls_private_key"
  },
  "Dkim": {
    "PrivateKeyPath": "/run/secrets/dkim_private_key",
    "Selector": "s202609",
    "EnableSigning": true
  },
  "Security": {
    "EnableSpfCheck": false,
    "EnableDmarcCheck": false,
    "PasswordHashScheme": "BLF-CRYPT"
  },
  "Filtering": {
    "RspamdEndpoint": "http://127.0.0.1:11333/checkv2",
    "TimeoutSeconds": 70
  },
  "Queue": {
    "PollIntervalMilliseconds": 500,
    "LeaseSeconds": 300,
    "MaxAttempts": 20,
    "MaxAgeHours": 120,
    "CompletedRetentionDays": 14
  },
  "Limits": {
    "MaxMessageSizeBytes": 26214400,
    "MaxRecipientsPerMessage": 100,
    "ConnectionTimeoutSeconds": 300,
    "MaxConnectionsPerIp": 20
  },
  "General": {
    "AllowRegistration": false
  },
  "Admin": {
    "AllowedNetworks": [
      "127.0.0.0/8",
      "172.30.8.0/24"
    ],
    "DataProtectionKeyPath": "/var/lib/mk8email-admin/data-protection",
    "AuditLogPath": "/var/log/mk8email-admin/audit.jsonl",
    "HealthStatusPath": "/var/lib/mk8email-admin/health-status.json",
    "SessionMinutes": 30
  }
}

#!/bin/sh
set -eu

if [ "$#" -ne 5 ] && [ "$#" -ne 6 ]; then
    printf '%s\n' "Usage: install-native-release ARCHIVE RELEASE_ID COMMIT ARTIFACT_SHA256 ASSET_SHA256 [--stage-only]" >&2
    exit 2
fi
if [ "$#" -eq 6 ] && [ "$6" != --stage-only ]; then
    printf '%s\n' "The optional release mode must be --stage-only." >&2
    exit 2
fi

archive=$1
release_id=$2
source_commit=$3
artifact_digest=$4
asset_digest=$5

fail() {
    printf '%s\n' "$1" >&2
    exit 1
}

if [ ! -f "$archive" ]; then
    printf '%s\n' "The release archive does not exist." >&2
    exit 1
fi

case "$release_id" in
    *[!0-9a-f]*|'')
        fail "The release identifier is not valid."
        ;;
esac
if [ "${#source_commit}" -ne 40 ] \
    || ! printf '%s\n' "$source_commit" | grep -Eq '^[0-9a-f]{40}$'; then
    fail "The source commit is not valid."
fi
for digest in "$artifact_digest" "$asset_digest"; do
    if [ "${#digest}" -ne 64 ] \
        || ! printf '%s\n' "$digest" | grep -Eq '^[0-9a-f]{64}$'; then
        fail "A release digest is not valid."
    fi
done
expected_release_id=$(printf '%s\n%s\n' "$artifact_digest" "$asset_digest" \
    | sha256sum | cut -c1-16)
[ "$release_id" = "$expected_release_id" ] \
    || fail "The release identifier does not match its digests."
[ "$(sha256sum "$archive" | cut -d' ' -f1)" = "$artifact_digest" ] \
    || fail "The release archive does not match its digest."

release_root=/opt/mk8email/releases
release_dir="$release_root/$release_id"
stage="$release_root/.installing-$release_id"

if [ -e "$release_dir" ] || [ -e "$stage" ]; then
    printf '%s\n' "The release target already exists." >&2
    exit 1
fi

cleanup() {
    case "$stage" in
        /opt/mk8email/releases/.installing-*)
            if [ -d "$stage" ]; then
                rm -rf -- "$stage"
            fi
            ;;
    esac
}
trap cleanup EXIT INT TERM

install -d -o root -g root -m 0755 /opt/mk8email "$release_root" "$stage"
tar --extract --gzip --file="$archive" --directory="$stage" --no-same-owner
test -f "$stage/cli/mk8.email.Application.CLI.dll"
test -f "$stage/cli/mk8.email.Application.CLI.runtimeconfig.json"
test -f "$stage/admin/mk8.email.Gateway.dll"
test -f "$stage/admin/mk8.email.Gateway.runtimeconfig.json"
test -f "$stage/worker/mk8.email.Application.Worker.dll"
test -f "$stage/worker/mk8.email.Application.Worker.runtimeconfig.json"
if find "$stage" -mindepth 1 -maxdepth 1 \
    ! -name cli ! -name admin ! -name worker -print -quit | grep -q .; then
    fail "The release archive contains an unexpected top-level entry."
fi
if find "$stage" ! -type d ! -type f -print -quit | grep -q .; then
    fail "The release archive contains a special file."
fi

printf 'commit=%s\nartifact_sha256=%s\nassets_sha256=%s\nrelease_id=%s\n' \
    "$source_commit" "$artifact_digest" "$asset_digest" "$release_id" \
    > "$stage/.mk8email-release"

chown -R root:root "$stage"
find "$stage" -type d -exec chmod 0555 {} +
find "$stage" -type f -exec chmod 0444 {} +
mv "$stage" "$release_dir"
stage=
touch "$release_dir"
if [ "$#" -eq 5 ]; then
    ln -sfnT "$release_dir" /opt/mk8email/current
fi

printf '%s\n' "$release_dir"

#!/bin/sh
set -eu

# Refuse tracked templates before any target or service mutation.
if LC_ALL=C grep -Eq '[@]{2}MK8_[A-Z0-9_]+[@]{2}' "$0"; then
    printf '%s\n' "Render required deployment inputs before using this template." >&2
    exit 2
fi

if [ "$(id -u)" -ne 0 ] || [ "$#" -gt 1 ]; then
    printf '%s\n' "Usage: certificate_deploy_smoke [DEPLOY_SCRIPT]" >&2
    exit 2
fi

deploy_script=${1:-/usr/local/sbin/deploy-mk8-certificate}
[ -r "$deploy_script" ] || {
    printf '%s\n' "The certificate deployment script is not readable." >&2
    exit 1
}

test_root=$(mktemp -d /run/mk8-certificate-smoke.XXXXXX)
cleanup() {
    case "$test_root" in
        /run/mk8-certificate-smoke.*) rm -rf -- "$test_root" ;;
    esac
}
trap cleanup EXIT HUP INT TERM

host_state_before=$(sha256sum \
    /etc/mk8email/tls/fullchain.pem \
    /etc/mk8email/tls/privkey.pem \
    | sha256sum | cut -d ' ' -f 1)

for directory in current current-archive old alternate invalid destination; do
    install -d -o root -g root -m 0700 "$test_root/$directory"
done
install -o root -g root -m 0644 /etc/mk8email/tls/fullchain.pem \
    "$test_root/current-archive/fullchain.pem"
install -o root -g root -m 0600 /etc/mk8email/tls/privkey.pem \
    "$test_root/current-archive/privkey.pem"
ln -s ../current-archive/fullchain.pem "$test_root/current/fullchain.pem"
ln -s ../current-archive/privkey.pem "$test_root/current/privkey.pem"

generate_certificate() {
    output_directory=$1
    common_name=$2
    subject_names=$3
    openssl req -x509 -newkey rsa:2048 -sha256 -nodes -days 30 \
        -subj "/CN=$common_name" \
        -addext "subjectAltName=$subject_names" \
        -addext "extendedKeyUsage=serverAuth" \
        -keyout "$output_directory/privkey.pem" \
        -out "$output_directory/fullchain.pem" >/dev/null 2>&1
    chown root:root "$output_directory/fullchain.pem" \
        "$output_directory/privkey.pem"
    chmod 0644 "$output_directory/fullchain.pem"
    chmod 0600 "$output_directory/privkey.pem"
}

generate_certificate "$test_root/old" @@MK8_MAIL_HOST@@ "DNS:@@MK8_MAIL_HOST@@"
generate_certificate "$test_root/alternate" @@MK8_MAIL_HOST@@ "DNS:@@MK8_MAIL_HOST@@"
generate_certificate "$test_root/invalid" invalid.example "DNS:invalid.example"
install -d -o root -g tlskeys -m 0751 "$test_root/destination"
install -o root -g tlskeys -m 0444 "$test_root/old/fullchain.pem" \
    "$test_root/destination/fullchain.pem"
install -o root -g tlskeys -m 0440 "$test_root/old/privkey.pem" \
    "$test_root/destination/privkey.pem"

command_stub=$test_root/command-stub
cat > "$command_stub" <<'EOF'
#!/bin/sh
set -eu

case "${0##*/}" in
    nginx)
        exit 0
        ;;
    systemctl)
        case "${1:-}" in
            is-active)
                case "${3:-${2:-}}" in
                    postfix.service|dovecot.service) exit 1 ;;
                    *) exit 0 ;;
                esac
                ;;
            reload)
                smoke_root=${MK8_CERTIFICATE_SMOKE_ROOT:?}
                if [ -f "$smoke_root/fail-reload-once" ]; then
                    rm -f -- "$smoke_root/fail-reload-once"
                    exit 1
                fi
                printf '%s\n' "${2:-missing}" >> "$smoke_root/reload.log"
                exit 0
                ;;
            *) exit 1 ;;
        esac
        ;;
    *) exit 1 ;;
esac
EOF
chown root:root "$command_stub"
chmod 0700 "$command_stub"

# The child shell expands its positional parameters.
# shellcheck disable=SC2016
if ! unshare --mount sh -eu -c '
    mount --make-rprivate /
    mount --bind "$1" /etc/mk8email/tls
    for command_path in /usr/sbin/nginx /usr/bin/systemctl; do
        mount --bind "$2" "$command_path"
        mount -o remount,bind,exec "$command_path"
    done
    export MK8_CERTIFICATE_SMOKE_ROOT="$7"

    if RENEWED_LINEAGE="$6" sh "$3" mail \
        > "$7/invalid-name.log" 2>&1; then
        printf "%s\n" "Certificate deployment accepted an invalid service name." >&2
        exit 1
    fi
    grep -F "The certificate does not cover @@MK8_MAIL_HOST@@." \
        "$7/invalid-name.log" >/dev/null
    cmp --silent "$7/old/fullchain.pem" /etc/mk8email/tls/fullchain.pem
    cmp --silent "$7/old/privkey.pem" /etc/mk8email/tls/privkey.pem

    : > "$7/reload.log"
    RENEWED_LINEAGE="$4" sh "$3" mail > "$7/success.log"
    grep -F "The mail certificate is installed and active" \
        "$7/success.log" >/dev/null
    cmp --silent "$4/fullchain.pem" /etc/mk8email/tls/fullchain.pem
    cmp --silent "$4/privkey.pem" /etc/mk8email/tls/privkey.pem
    test "$(stat -c "%U:%G %a" /etc/mk8email/tls/fullchain.pem)" \
        = "root:tlskeys 444"
    test "$(stat -c "%U:%G %a" /etc/mk8email/tls/privkey.pem)" \
        = "root:tlskeys 440"
    test "$(wc -l < "$7/reload.log" | tr -d " ")" -eq 1
    grep -Fx nginx.service "$7/reload.log" >/dev/null

    : > "$7/fail-reload-once"
    if RENEWED_LINEAGE="$5" sh "$3" mail \
        > "$7/reload-failure.log" 2>&1; then
        printf "%s\n" "Certificate deployment ignored a reload failure." >&2
        exit 1
    fi
    grep -F "The prior certificate was restored." \
        "$7/reload-failure.log" >/dev/null
    test ! -e "$7/fail-reload-once"
    cmp --silent "$4/fullchain.pem" /etc/mk8email/tls/fullchain.pem
    cmp --silent "$4/privkey.pem" /etc/mk8email/tls/privkey.pem

    if RENEWED_LINEAGE="$5" sh "$3" mail \
        > "$7/presentation-failure.log" 2>&1; then
        printf "%s\n" "Certificate deployment ignored a presentation mismatch." >&2
        exit 1
    fi
    grep -F "A local TLS endpoint did not present the new certificate" \
        "$7/presentation-failure.log" >/dev/null
    grep -F "The prior certificate was restored." \
        "$7/presentation-failure.log" >/dev/null
    cmp --silent "$4/fullchain.pem" /etc/mk8email/tls/fullchain.pem
    cmp --silent "$4/privkey.pem" /etc/mk8email/tls/privkey.pem
    test -z "$(find /etc/mk8email/tls -maxdepth 1 \
        -type f -name "*.mk8-*" -print -quit)"
' sh "$test_root/destination" "$command_stub" "$deploy_script" \
    "$test_root/current" "$test_root/alternate" "$test_root/invalid" \
    "$test_root"; then
    printf '%s\n' "The isolated certificate deployment test failed." >&2
    for log_file in "$test_root"/*.log; do
        [ -f "$log_file" ] || continue
        printf 'Log %s:\n' "${log_file##*/}" >&2
        sed -n '1,120p' "$log_file" >&2
    done
    exit 1
fi

host_state_after=$(sha256sum \
    /etc/mk8email/tls/fullchain.pem \
    /etc/mk8email/tls/privkey.pem \
    | sha256sum | cut -d ' ' -f 1)
[ "$host_state_after" = "$host_state_before" ] || {
    printf '%s\n' "The certificate smoke test changed a host certificate." >&2
    exit 1
}

printf '%s\n' "Certificate validation, activation, isolation, and rollback tests passed."

[Unit]
Description=Check mk8 mail service health
After=network-online.target mk8email-gateway.service mk8email-wake.service mk8email-worker.path mk8email-worker-maintenance.timer rspamd.service clamav-daemon.service valkey-server.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/mk8-mail-health
UMask=0077
Nice=10
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/mk8-mail-health
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH
IPAddressDeny=any
IPAddressAllow=localhost
IPAddressAllow=@@MK8_SERVER_IPV4@@/32

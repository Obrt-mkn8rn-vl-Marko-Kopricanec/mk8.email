#!/bin/sh
set -eu

if [ "$(id -u)" -ne 0 ] || [ "$#" -ne 0 ]; then
    printf '%s\n' "Usage: multi_domain_smoke" >&2
    exit 2
fi

export LC_ALL=C
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
umask 077

domain=mk8-multi-domain-smoke.invalid
company='mk8 multi-domain smoke'
account=postmaster@$domain
domain_directory=/etc/mk8email/domains/$domain
key_directory=/etc/mk8email/dkim/$domain
web_directory=/var/www/mk8email-domains/$domain
nginx_configuration=/etc/nginx/mk8email-domains.d/$domain.conf
cli_dll=/opt/mk8email/current/cli/mk8.email.Application.CLI.dll
work=$(mktemp -d /run/mk8-multi-domain-smoke.XXXXXX)
test_started=false

run_internal_cli() {
    DOTNET_ENVIRONMENT=Production \
    DOTNET_EnableDiagnostics=0 \
    MK8EMAIL_CONFIG_FILE=/etc/mk8email/mk8email.config.json \
        /usr/bin/dotnet "$cli_dll" "$@"
}

database_value() {
    runuser -u postgres -- psql --dbname=mk8email --no-psqlrc \
        --tuples-only --no-align --command="$1"
}

remove_test_directory() {
    removed_path=$1
    expected_parent=$2
    [ -e "$removed_path" ] || return 0
    [ ! -L "$removed_path" ] && [ -d "$removed_path" ] || return 1
    [ "$(readlink -f -- "$(dirname -- "$removed_path")")" = "$expected_parent" ] \
        || return 1
    rm -rf -- "$removed_path"
}

cleanup_test_state() {
    state_cleanup_status=0
    if [ "$test_started" = true ]; then
        if [ "$(database_value "SELECT count(*) FROM addresses WHERE domain = '$domain'")" -gt 0 ]; then
            run_internal_cli --set-domain-active "$domain" false >/dev/null \
                || state_cleanup_status=1
        fi
        rm -f -- "$nginx_configuration" || state_cleanup_status=1
        nginx -t >/dev/null 2>&1 || state_cleanup_status=1
        systemctl reload nginx.service || state_cleanup_status=1
        remove_test_directory "$domain_directory" /etc/mk8email/domains \
            || state_cleanup_status=1
        remove_test_directory "$key_directory" /etc/mk8email/dkim \
            || state_cleanup_status=1
        remove_test_directory "$web_directory" /var/www/mk8email-domains \
            || state_cleanup_status=1
        /usr/local/sbin/mk8-domain rebuild-signing-maps >/dev/null \
            || state_cleanup_status=1
        database_value "BEGIN; DELETE FROM users WHERE username = '$account'; DELETE FROM addresses WHERE domain = '$domain'; DELETE FROM companies WHERE name = '$company' AND NOT EXISTS (SELECT 1 FROM addresses WHERE company_id = companies.id) AND NOT EXISTS (SELECT 1 FROM users WHERE company_id = companies.id); COMMIT;" >/dev/null \
            || state_cleanup_status=1
    fi
    if [ "$state_cleanup_status" -eq 0 ]; then
        test_started=false
    fi
    return "$state_cleanup_status"
}

cleanup() {
    test_status=$?
    trap - EXIT HUP INT TERM
    set +e
    cleanup_test_state
    cleanup_status=$?
    case "$work" in
        /run/mk8-multi-domain-smoke.*) rm -rf -- "$work" ;;
        *) cleanup_status=1 ;;
    esac
    if [ "$cleanup_status" -ne 0 ]; then
        printf '%s\n' "The multi-domain test cleanup failed." >&2
        test_status=1
    fi
    exit "$test_status"
}
trap cleanup EXIT
trap 'exit 1' HUP INT TERM

[ -f "$cli_dll" ] || {
    printf '%s\n' "The management command is not installed." >&2
    exit 1
}
primary_public_ipv4=$(cat /etc/mk8email/public-ipv4)
grep -Fx "email IN A $primary_public_ipv4 ; cf_tags=cf-proxied:false" \
    /etc/mk8email/domains/mk8n.com/cloudflare-import.zone >/dev/null \
    || { printf '%s\n' "The primary domain import omits its canonical A record." >&2; exit 1; }
[ "$(database_value "SELECT count(*) FROM addresses WHERE domain = '$domain'")" -eq 0 ] \
    || { printf '%s\n' "The test domain already exists." >&2; exit 1; }
[ "$(database_value "SELECT count(*) FROM companies WHERE name = '$company'")" -eq 0 ] \
    || { printf '%s\n' "The test company already exists." >&2; exit 1; }
for unused_path in "$domain_directory" "$key_directory" "$web_directory" \
    "$nginx_configuration"; do
    if [ -e "$unused_path" ] || [ -L "$unused_path" ]; then
        printf '%s\n' "A multi-domain test path already exists." >&2
        exit 1
    fi
done
test_started=true

openssl rand -hex 24 > "$work/password"
/usr/local/sbin/mk8-domain prepare "$company" "$domain" >/dev/null
selector=$(sed -n '1p' "$domain_directory/dkim-selector")
selector_key="$key_directory/$selector.private.pem"
initial_selector_key_hash=$(sha256sum "$selector_key" | cut -d ' ' -f 1)
initial_mta_sts_id=$(sed -n '1p' "$domain_directory/mta-sts-id")
/usr/local/sbin/mk8-domain prepare "$company" "$domain" >/dev/null
[ "$(sha256sum "$selector_key" | cut -d ' ' -f 1)" = "$initial_selector_key_hash" ] \
    || { printf '%s\n' "Repeated preparation changed the active DKIM key." >&2; exit 1; }
[ "$(sed -n '1p' "$domain_directory/mta-sts-id")" = "$initial_mta_sts_id" ] \
    || { printf '%s\n' "Repeated preparation changed an unchanged MTA-STS identifier." >&2; exit 1; }
grep -Fx "\$ORIGIN $domain." "$domain_directory/cloudflare-import.zone" >/dev/null
grep -Fx "@ IN MX 10 email.mk8n.com." \
    "$domain_directory/cloudflare-import.zone" >/dev/null
grep -Fx "_pop3._tcp IN SRV 0 1 110 email.mk8n.com." \
    "$domain_directory/cloudflare-import.zone" >/dev/null
grep -Fx "_pop3s._tcp IN SRV 0 1 995 email.mk8n.com." \
    "$domain_directory/cloudflare-import.zone" >/dev/null
grep -Fx "_sieve._tcp IN SRV 0 1 4190 email.mk8n.com." \
    "$domain_directory/cloudflare-import.zone" >/dev/null
grep -Fx "_caldavs._tcp IN SRV 0 1 443 email.mk8n.com." \
    "$domain_directory/cloudflare-import.zone" >/dev/null
grep -Fx '_caldavs._tcp IN TXT "path=/dav/"' \
    "$domain_directory/cloudflare-import.zone" >/dev/null
grep -Fx "_carddavs._tcp IN SRV 0 1 443 email.mk8n.com." \
    "$domain_directory/cloudflare-import.zone" >/dev/null
grep -Fx '_carddavs._tcp IN TXT "path=/dav/"' \
    "$domain_directory/cloudflare-import.zone" >/dev/null
grep -Fx "autoconfig IN CNAME email.mk8n.com. ; cf_tags=cf-proxied:false" \
    "$domain_directory/cloudflare-import.zone" >/dev/null
grep -F '<incomingServer type="pop3">' \
    "$web_directory/autoconfig/mail/config-v1.1.xml" >/dev/null
grep -F '<incomingServer type="jmap">' \
    "$web_directory/autoconfig/mail/config-v1.1.xml" >/dev/null
grep -F '<calendar type="caldav">' \
    "$web_directory/autoconfig/mail/config-v1.1.xml" >/dev/null
grep -F '<addressbook type="carddav">' \
    "$web_directory/autoconfig/mail/config-v1.1.xml" >/dev/null
grep -Fx "$domain $selector" /etc/rspamd/dkim_selectors.map >/dev/null
grep -Fx "$domain $selector_key" /etc/rspamd/dkim_paths.map >/dev/null
runuser -u _rspamd -- test -r "$selector_key"
/usr/local/sbin/mk8email --create-account "$account" User "$work/password" >/dev/null
/usr/local/sbin/mk8email --set-catchall "$domain" "$account" >/dev/null

python3 /usr/local/lib/mk8email/tests/multi_domain_smoke.py pending \
    --domain "$domain" --account "$account" --password-file "$work/password"

install -d -o root -g root -m 0700 "$work/lineage"
openssl req -x509 -newkey rsa:2048 -sha256 -nodes -days 30 \
    -subj "/CN=autoconfig.$domain" \
    -addext "subjectAltName=DNS:autoconfig.$domain,DNS:mta-sts.$domain" \
    -addext "extendedKeyUsage=serverAuth" \
    -keyout "$work/lineage/privkey.pem" \
    -out "$work/lineage/fullchain.pem" >/dev/null 2>&1
chown root:root "$work/lineage/fullchain.pem" "$work/lineage/privkey.pem"
chmod 0644 "$work/lineage/fullchain.pem"
chmod 0600 "$work/lineage/privkey.pem"
RENEWED_LINEAGE=$work/lineage \
    /usr/local/sbin/deploy-mk8-domain-certificate "$domain" >/dev/null
installed_certificate_hash=$(sha256sum "$domain_directory/tls/fullchain.pem" \
    | cut -d ' ' -f 1)

python3 - "$nginx_configuration" "$work/legacy-nginx.conf" "$domain" <<'PY'
from pathlib import Path
import sys

source = Path(sys.argv[1]).read_text(encoding="utf-8")
well_known_location = """    location = /.well-known/autoconfig/mail/config-v1.1.xml {
        alias /var/www/mk8email-domains/@@DOMAIN@@/autoconfig/mail/config-v1.1.xml;
        default_type application/xml;
    }

""".replace("@@DOMAIN@@", sys.argv[3])
if source.count(well_known_location) != 1:
    raise SystemExit("The generated domain configuration has an unexpected shape.")
Path(sys.argv[2]).write_text(
    source.replace(well_known_location, ""), encoding="utf-8"
)
PY
install -o root -g root -m 0644 "$work/legacy-nginx.conf" \
    "$nginx_configuration"
nginx -t >/dev/null
systemctl reload nginx.service
legacy_configuration_active=false
for _ in $(seq 1 10); do
    legacy_status=$(curl --silent --insecure --max-time 5 --noproxy '*' \
        --output /dev/null --write-out '%{http_code}' \
        --resolve "autoconfig.$domain:443:127.0.0.1" \
        "https://autoconfig.$domain/.well-known/autoconfig/mail/config-v1.1.xml" \
        2>/dev/null || true)
    if [ "$legacy_status" = 404 ]; then
        legacy_configuration_active=true
        break
    fi
    sleep 1
done
[ "$legacy_configuration_active" = true ] \
    || { printf '%s\n' "The legacy domain web configuration did not become active." >&2; exit 1; }
/usr/local/sbin/mk8-domain rebuild-web-configs >/dev/null
grep -F 'location = /.well-known/autoconfig/mail/config-v1.1.xml {' \
    "$nginx_configuration" >/dev/null
curl --silent --fail --insecure --max-time 5 --noproxy '*' \
    --resolve "autoconfig.$domain:443:127.0.0.1" \
    "https://autoconfig.$domain/.well-known/autoconfig/mail/config-v1.1.xml" \
    | cmp --silent - "$web_directory/autoconfig/mail/config-v1.1.xml" \
    || { printf '%s\n' "The migrated well-known autoconfiguration route is not ready." >&2; exit 1; }

install -d -o root -g root -m 0700 "$work/invalid-lineage"
openssl req -x509 -newkey rsa:2048 -sha256 -nodes -days 30 \
    -subj "/CN=invalid.$domain" \
    -addext "subjectAltName=DNS:invalid.$domain" \
    -addext "extendedKeyUsage=serverAuth" \
    -keyout "$work/invalid-lineage/privkey.pem" \
    -out "$work/invalid-lineage/fullchain.pem" >/dev/null 2>&1
chown root:root "$work/invalid-lineage/fullchain.pem" \
    "$work/invalid-lineage/privkey.pem"
chmod 0644 "$work/invalid-lineage/fullchain.pem"
chmod 0600 "$work/invalid-lineage/privkey.pem"
if RENEWED_LINEAGE=$work/invalid-lineage \
    /usr/local/sbin/deploy-mk8-domain-certificate "$domain" \
    > "$work/invalid-certificate.log" 2>&1; then
    printf '%s\n' "The domain certificate command accepted an invalid name." >&2
    exit 1
fi
grep -F "The certificate does not cover autoconfig.$domain." \
    "$work/invalid-certificate.log" >/dev/null
[ "$(sha256sum "$domain_directory/tls/fullchain.pem" | cut -d ' ' -f 1)" \
    = "$installed_certificate_hash" ] \
    || { printf '%s\n' "A rejected certificate changed the active certificate." >&2; exit 1; }

run_internal_cli --set-domain-active "$domain" true >/dev/null
python3 /usr/local/lib/mk8email/tests/multi_domain_smoke.py active \
    --domain "$domain" --account "$account" --password-file "$work/password" \
    --selector "$selector"

deactivation_log=$work/deactivation.log
/usr/local/sbin/mk8-domain deactivate "$domain" >/dev/null 2>"$deactivation_log"
if [ -s "$deactivation_log" ]; then
    printf '%s\n' "The domain command wrote an unexpected deactivation error." >&2
    exit 1
fi
python3 /usr/local/lib/mk8email/tests/multi_domain_smoke.py pending \
    --domain "$domain" --account "$account" --password-file "$work/password"

if ! cleanup_test_state; then
    printf '%s\n' "The multi-domain test cleanup failed." >&2
    exit 1
fi
[ "$(database_value "SELECT count(*) FROM addresses WHERE domain = '$domain'")" -eq 0 ]
if grep -q "^$domain " /etc/rspamd/dkim_selectors.map \
    || grep -q "^$domain " /etc/rspamd/dkim_paths.map; then
    printf '%s\n' "A multi-domain test signing-map entry remains after cleanup." >&2
    exit 1
fi
for removed_path in "$domain_directory" "$key_directory" "$web_directory" \
    "$nginx_configuration"; do
    if [ -e "$removed_path" ] || [ -L "$removed_path" ]; then
        printf '%s\n' "A multi-domain test path remains after cleanup." >&2
        exit 1
    fi
done
/usr/local/sbin/mk8-mail-health --deep --strict >/dev/null
printf '%s\n' "The isolated second-domain production test passed."

#!/bin/sh
set -eu

if [ "$(id -u)" -ne 0 ] || [ "$#" -ne 1 ]; then
    printf '%s\n' "Usage: install-mail-stack ASSET_ROOT" >&2
    exit 2
fi

asset_root=$1
primary_lineage=
mfa_key_work=
oidc_key_work=
cleanup() {
    if [ -n "$primary_lineage" ]; then
        case "$primary_lineage" in
            /run/mk8-primary-lineage.*) rm -rf -- "$primary_lineage" ;;
        esac
    fi
    if [ -n "$mfa_key_work" ]; then
        case "$mfa_key_work" in
            /run/mk8-mfa-key.*) rm -f -- "$mfa_key_work" ;;
        esac
    fi
    if [ -n "$oidc_key_work" ]; then
        case "$oidc_key_work" in
            /run/mk8-oidc-key.*) rm -f -- "$oidc_key_work" ;;
        esac
    fi
}
trap cleanup EXIT HUP INT TERM

if [ ! -d "$asset_root/deploy" ]; then
    printf '%s\n' "The deployment asset root is not valid." >&2
    exit 1
fi

sh "$asset_root/deploy/scripts/verify-host-prerequisites" \
    "$asset_root/deploy/prerequisites"

for command_name in rspamadm clamd freshclam valkey-server nginx nft fail2ban-client psql s-nail openssl; do
    if ! command -v "$command_name" >/dev/null 2>&1; then
        printf '%s\n' "A required mail command is missing: $command_name" >&2
        exit 1
    fi
done

rm -f -- /etc/mk8email/mail-stack-ready
aide_state=$(systemctl show dailyaidecheck.service --property=ActiveState --value 2>/dev/null || true)
case "$aide_state" in
    active|activating|deactivating) aide_was_active=yes ;;
    *) aide_was_active=no ;;
esac
systemctl stop mk8-mail-health.timer mk8-backup.timer dailyaidecheck.timer \
    dailyaidecheck.service 2>/dev/null || true
if [ "$aide_was_active" = yes ]; then
    systemctl reset-failed dailyaidecheck.service
fi
systemctl stop mk8email.service mk8email-admin.service mk8email-gateway.service \
    mk8email-worker.path mk8email-worker-maintenance.timer mk8email-wake.service \
    mk8email-worker-drain.service mk8email-worker.service \
    postfix.service dovecot.service rspamd.service \
    clamav-freshclam.service clamav-daemon.service clamav-daemon.socket valkey-server.service 2>/dev/null || true
systemctl disable mk8email-worker.path mk8email-worker-maintenance.timer \
    mk8email-wake.service 2>/dev/null || true
systemctl unmask mk8email.service
systemctl disable postfix.service dovecot.service 2>/dev/null || true
systemctl mask postfix.service dovecot.service
timeout 300s env DEBIAN_FRONTEND=noninteractive apt-get purge --yes \
    postfix postfix-pcre postfix-pgsql \
    dovecot-core dovecot-imapd dovecot-lmtpd dovecot-pgsql dovecot-sieve

if [ -L /var/vmail ] \
    || { [ -e /var/vmail ] && [ ! -d /var/vmail ]; }; then
    printf '%s\n' "The legacy mail storage path is unsafe." >&2
    exit 1
fi
if [ -d /var/vmail ] \
    && find /var/vmail -mindepth 1 -print -quit | grep -q .; then
    printf '%s\n' "The legacy mail storage is not empty." >&2
    exit 1
fi
if findmnt --mountpoint /var/vmail >/dev/null 2>&1; then
    systemctl stop var-vmail.mount
fi
systemctl disable var-vmail.mount 2>/dev/null || true
if findmnt --mountpoint /var/vmail >/dev/null 2>&1; then
    printf '%s\n' "The legacy mail storage mount did not stop." >&2
    exit 1
fi

rm -rf -- /etc/postfix /etc/dovecot /var/spool/postfix /var/lib/dovecot /var/vmail
rm -f -- /etc/systemd/system/var-vmail.mount /etc/mailname
rm -rf -- /etc/systemd/system/postfix@.service.d \
    /etc/systemd/system/dovecot.service.d
if getent passwd vmail >/dev/null; then
    userdel vmail
fi
if getent group vmail >/dev/null; then
    groupdel vmail
fi

getent group tlskeys >/dev/null || groupadd --system tlskeys
getent group dkimkeys >/dev/null || groupadd --system dkimkeys
sh "$asset_root/deploy/scripts/ensure-wake-service-account"
usermod --append --groups tlskeys mk8email
usermod --append --groups dkimkeys,clamav _rspamd

install -d -o root -g mk8email -m 0751 /etc/mk8email
install -d -o root -g mk8email -m 0750 /etc/mk8email/secrets
mfa_key=/etc/mk8email/secrets/mfa_encryption_key
if [ -L "$mfa_key" ] || { [ -e "$mfa_key" ] && [ ! -f "$mfa_key" ]; }; then
    printf '%s\n' "The MFA encryption key path is unsafe." >&2
    exit 1
fi
if [ ! -e "$mfa_key" ]; then
    mfa_key_work=$(mktemp /run/mk8-mfa-key.XXXXXX)
    openssl rand -base64 32 > "$mfa_key_work"
    install -o root -g mk8email -m 0640 "$mfa_key_work" "$mfa_key"
    rm -f -- "$mfa_key_work"
    mfa_key_work=
fi
[ "$(stat -c '%U:%G %a %h' "$mfa_key")" = "root:mk8email 640 1" ] || {
    printf '%s\n' "The MFA encryption key has unsafe metadata." >&2
    exit 1
}
[ "$(openssl base64 -d -A -in "$mfa_key" | wc -c | tr -d ' ')" -eq 32 ] || {
    printf '%s\n' "The MFA encryption key is not a base64-encoded 256-bit key." >&2
    exit 1
}
oidc_key=/etc/mk8email/secrets/oidc_signing_key.pem
if [ -L "$oidc_key" ] || { [ -e "$oidc_key" ] && [ ! -f "$oidc_key" ]; }; then
    printf '%s\n' "The OpenID Connect signing key path is unsafe." >&2
    exit 1
fi
if [ ! -e "$oidc_key" ]; then
    oidc_key_work=$(mktemp /run/mk8-oidc-key.XXXXXX)
    openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:3072 \
        -out "$oidc_key_work" 2>/dev/null
    install -o root -g mk8email -m 0640 "$oidc_key_work" "$oidc_key"
    rm -f -- "$oidc_key_work"
    oidc_key_work=
fi
[ "$(stat -c '%U:%G %a %h' "$oidc_key")" = "root:mk8email 640 1" ] || {
    printf '%s\n' "The OpenID Connect signing key has unsafe metadata." >&2
    exit 1
}
openssl pkey -in "$oidc_key" -check -noout >/dev/null 2>&1 || {
    printf '%s\n' "The OpenID Connect signing key is not valid." >&2
    exit 1
}
install -o root -g mk8email -m 0640 "$asset_root/deploy/native/mk8email.config.json" /etc/mk8email/mk8email.config.json
install -o root -g root -m 0644 "$asset_root/deploy/mk8email-public-ipv4" /etc/mk8email/public-ipv4

install -d -o root -g root -m 0755 /etc/nftables.d
if [ -L /etc/nftables.d/90-local-services.nft ] \
    || { [ -e /etc/nftables.d/90-local-services.nft ] \
        && [ ! -f /etc/nftables.d/90-local-services.nft ]; }; then
    printf '%s\n' "The local firewall file is not safe." >&2
    exit 1
fi
if [ ! -e /etc/nftables.d/90-local-services.nft ]; then
    install -o root -g root -m 0600 /dev/null \
        /etc/nftables.d/90-local-services.nft
fi
[ "$(stat -c '%U:%G %a %h' /etc/nftables.d/90-local-services.nft)" \
    = "root:root 600 1" ] || {
    printf '%s\n' "The local firewall file has unsafe metadata." >&2
    exit 1
}

install -d -o root -g tlskeys -m 0751 /etc/mk8email/tls
test -s /etc/mk8email/tls/fullchain.pem
test -s /etc/mk8email/tls/privkey.pem
chown root:tlskeys /etc/mk8email/tls/fullchain.pem /etc/mk8email/tls/privkey.pem
chmod 0444 /etc/mk8email/tls/fullchain.pem
chmod 0440 /etc/mk8email/tls/privkey.pem

install -d -o root -g root -m 0750 /etc/mk8email/admin-tls
test -s /etc/mk8email/admin-tls/fullchain.pem
test -s /etc/mk8email/admin-tls/privkey.pem
chown root:root /etc/mk8email/admin-tls/fullchain.pem /etc/mk8email/admin-tls/privkey.pem
chmod 0444 /etc/mk8email/admin-tls/fullchain.pem
chmod 0440 /etc/mk8email/admin-tls/privkey.pem

install -d -o root -g root -m 0750 /etc/mk8email/domains
install -d -o root -g dkimkeys -m 0751 /etc/mk8email/dkim
install -d -o root -g root -m 0750 /etc/mk8email/domains/mk8n.com
install -d -o root -g dkimkeys -m 0750 /etc/mk8email/dkim/mk8n.com
if [ ! -e /etc/mk8email/domains/mk8n.com/dkim-selector ]; then
    printf '%s\n' s202609 > /etc/mk8email/domains/mk8n.com/dkim-selector
    chown root:root /etc/mk8email/domains/mk8n.com/dkim-selector
    chmod 0644 /etc/mk8email/domains/mk8n.com/dkim-selector
fi
if [ ! -f /etc/mk8email/domains/mk8n.com/dkim-selector ] \
    || [ -L /etc/mk8email/domains/mk8n.com/dkim-selector ] \
    || [ "$(stat -c '%U:%G %a %h' /etc/mk8email/domains/mk8n.com/dkim-selector)" \
        != "root:root 644 1" ]; then
    printf '%s\n' "The primary DKIM selector file is not safe." >&2
    exit 1
fi
primary_selector=$(sed -n '1p' /etc/mk8email/domains/mk8n.com/dkim-selector)
case "$primary_selector" in
    ''|*[!a-z0-9]*)
        printf '%s\n' "The primary DKIM selector is not valid." >&2
        exit 1
        ;;
esac
[ "${#primary_selector}" -le 63 ] || {
    printf '%s\n' "The primary DKIM selector is too long." >&2
    exit 1
}
primary_key=/etc/mk8email/dkim/mk8n.com/$primary_selector.private.pem
legacy_key=/etc/mk8email/dkim/s202609.private.pem
legacy_key_migrated=false
if [ -e "$primary_key" ] || [ -L "$primary_key" ]; then
    if [ ! -f "$primary_key" ] || [ -L "$primary_key" ] \
        || [ "$(stat -c '%h' "$primary_key")" -ne 1 ] \
        || [ ! -s "$primary_key" ]; then
        printf '%s\n' "The primary DKIM key is not safe." >&2
        exit 1
    fi
else
    test "$primary_selector" = s202609
    if [ ! -f "$legacy_key" ] || [ -L "$legacy_key" ] \
        || [ "$(stat -c '%U %h' "$legacy_key")" != "root 1" ] \
        || [ ! -s "$legacy_key" ]; then
        printf '%s\n' "The legacy DKIM key is not safe." >&2
        exit 1
    fi
    install -o root -g dkimkeys -m 0640 "$legacy_key" "$primary_key"
    legacy_key_migrated=true
fi
if [ -e "$legacy_key" ] || [ -L "$legacy_key" ]; then
    if [ ! -f "$legacy_key" ] || [ -L "$legacy_key" ] \
        || [ "$(stat -c '%U %h' "$legacy_key")" != "root 1" ] \
        || [ ! -s "$legacy_key" ]; then
        printf '%s\n' "The legacy DKIM key is not safe." >&2
        exit 1
    fi
    openssl pkey -in "$primary_key" -noout -check </dev/null >/dev/null
    openssl pkey -in "$legacy_key" -noout -check </dev/null >/dev/null
    primary_public_key=$(openssl pkey -in "$primary_key" -pubout -outform DER 2>/dev/null \
        | sha256sum | cut -d ' ' -f 1)
    legacy_public_key=$(openssl pkey -in "$legacy_key" -pubout -outform DER 2>/dev/null \
        | sha256sum | cut -d ' ' -f 1)
    [ "$primary_public_key" = "$legacy_public_key" ] || {
        printf '%s\n' "The legacy and primary DKIM keys do not match." >&2
        exit 1
    }
    legacy_key_migrated=true
fi
chown root:dkimkeys "$primary_key"
chmod 0640 "$primary_key"

install -d -o root -g root -m 0755 /etc/rspamd/local.d
for rspamd_file in "$asset_root"/deploy/rspamd/local.d/*; do
    install -o root -g root -m 0644 "$rspamd_file" "/etc/rspamd/local.d/$(basename "$rspamd_file")"
done
if [ ! -e /etc/rspamd/dkim_selectors.map ]; then
    install -o root -g root -m 0644 "$asset_root/deploy/rspamd/dkim_selectors.map" /etc/rspamd/dkim_selectors.map
fi
if [ ! -e /etc/rspamd/dkim_paths.map ]; then
    install -o root -g root -m 0644 "$asset_root/deploy/rspamd/dkim_paths.map" /etc/rspamd/dkim_paths.map
fi

install -d -o clamav -g clamav -m 0750 /var/lib/clamav /var/log/clamav
install -o root -g root -m 0644 "$asset_root/deploy/clamav/clamd.conf" /etc/clamav/clamd.conf
install -o root -g root -m 0644 "$asset_root/deploy/clamav/freshclam.conf" /etc/clamav/freshclam.conf

install -o root -g valkey -m 0640 "$asset_root/deploy/valkey/valkey.conf" /etc/valkey/valkey.conf

install -d -o root -g root -m 0755 \
    /etc/systemd/system/rspamd.service.d \
    /etc/systemd/system/clamav-daemon.service.d \
    /etc/systemd/system/clamav-daemon.socket.d \
    /etc/systemd/system/clamav-freshclam.service.d \
    /etc/systemd/system/valkey-server.service.d
install -o root -g root -m 0644 "$asset_root/deploy/systemd/rspamd.service.d/90-mk8-hardening.conf" /etc/systemd/system/rspamd.service.d/90-mk8-hardening.conf
install -o root -g root -m 0644 "$asset_root/deploy/systemd/clamav-daemon.service.d/90-mk8-hardening.conf" /etc/systemd/system/clamav-daemon.service.d/90-mk8-hardening.conf
install -o root -g root -m 0644 "$asset_root/deploy/systemd/clamav-daemon.socket.d/90-mk8-hardening.conf" /etc/systemd/system/clamav-daemon.socket.d/90-mk8-hardening.conf
install -o root -g root -m 0644 "$asset_root/deploy/systemd/clamav-freshclam.service.d/90-mk8-hardening.conf" /etc/systemd/system/clamav-freshclam.service.d/90-mk8-hardening.conf
install -o root -g root -m 0644 "$asset_root/deploy/systemd/valkey-server.service.d/90-mk8-hardening.conf" /etc/systemd/system/valkey-server.service.d/90-mk8-hardening.conf
install -d -o root -g root -m 0755 /etc/systemd/system/dailyaidecheck.service.d
install -o root -g root -m 0644 "$asset_root/deploy/systemd/dailyaidecheck.service.d/90-mk8-hardening.conf" /etc/systemd/system/dailyaidecheck.service.d/90-mk8-hardening.conf
install -d -o root -g root -m 0755 /etc/systemd/system/dailyaidecheck.timer.d
install -o root -g root -m 0644 "$asset_root/deploy/systemd/dailyaidecheck.timer.d/90-mk8-schedule.conf" /etc/systemd/system/dailyaidecheck.timer.d/90-mk8-schedule.conf
install -o root -g root -m 0644 "$asset_root/deploy/aide/90_mk8_dynamic_data" /etc/aide/aide.conf.d/90_mk8_dynamic_data
install -o root -g root -m 0644 "$asset_root/deploy/default/aide" /etc/default/aide
install -d -o root -g root -m 0755 /etc/systemd/system/nginx.service.d
install -o root -g root -m 0644 "$asset_root/deploy/systemd/nginx.service.d/90-mk8-hardening.conf" /etc/systemd/system/nginx.service.d/90-mk8-hardening.conf
install -o root -g root -m 0644 "$asset_root/deploy/systemd/mk8email.service" /etc/systemd/system/mk8email.service
install -o root -g root -m 0644 "$asset_root/deploy/systemd/mk8email-admin.service" /etc/systemd/system/mk8email-admin.service
install -o root -g root -m 0644 "$asset_root/deploy/systemd/mk8email-gateway.service" /etc/systemd/system/mk8email-gateway.service
install -o root -g root -m 0644 "$asset_root/deploy/systemd/mk8email-worker.service" /etc/systemd/system/mk8email-worker.service
install -o root -g root -m 0644 "$asset_root/deploy/systemd/mk8email-worker-drain.service" /etc/systemd/system/mk8email-worker-drain.service
install -o root -g root -m 0644 "$asset_root/deploy/systemd/mk8email-wake.service" /etc/systemd/system/mk8email-wake.service
install -o root -g root -m 0644 "$asset_root/deploy/systemd/mk8email-worker.path" /etc/systemd/system/mk8email-worker.path
install -o root -g root -m 0644 "$asset_root/deploy/systemd/mk8email-worker-maintenance.timer" /etc/systemd/system/mk8email-worker-maintenance.timer
install -o root -g root -m 0644 "$asset_root/deploy/systemd/mk8-mail-health.service" /etc/systemd/system/mk8-mail-health.service
install -o root -g root -m 0644 "$asset_root/deploy/systemd/mk8-mail-health.timer" /etc/systemd/system/mk8-mail-health.timer

install -o root -g root -m 0755 "$asset_root/deploy/scripts/configure-mail-database-access" /usr/local/sbin/configure-mail-database-access
install -o root -g root -m 0755 "$asset_root/deploy/scripts/configure-gateway-database-access" /usr/local/sbin/configure-gateway-database-access
install -o root -g root -m 0755 "$asset_root/deploy/scripts/configure-wake-database-access" /usr/local/sbin/configure-wake-database-access
install -o root -g root -m 0755 "$asset_root/deploy/scripts/ensure-wake-service-account" /usr/local/sbin/ensure-wake-service-account
install -o root -g root -m 0755 "$asset_root/deploy/scripts/configure-apt-sources" /usr/local/sbin/configure-apt-sources
install -o root -g root -m 0755 "$asset_root/deploy/scripts/activate-mail-stack" /usr/local/sbin/activate-mail-stack
install -o root -g root -m 0755 "$asset_root/deploy/scripts/activate-distributed-role" /usr/local/sbin/activate-distributed-role
install -o root -g root -m 0755 "$asset_root/deploy/scripts/install-distributed-role" /usr/local/sbin/install-distributed-role
install -o root -g root -m 0755 "$asset_root/deploy/scripts/upgrade-distributed-role" /usr/local/sbin/upgrade-distributed-role
install -o root -g root -m 0755 "$asset_root/deploy/scripts/deactivate-mail-stack" /usr/local/sbin/deactivate-mail-stack
install -o root -g root -m 0755 "$asset_root/deploy/scripts/deactivate-distributed-role" /usr/local/sbin/deactivate-distributed-role
install -o root -g root -m 0755 "$asset_root/deploy/scripts/mk8-mail-health" /usr/local/sbin/mk8-mail-health
install -o root -g root -m 0755 "$asset_root/deploy/scripts/mk8-backup" /usr/local/sbin/mk8-backup
install -o root -g root -m 0755 "$asset_root/deploy/scripts/mk8-export-backup" /usr/local/sbin/mk8-export-backup
install -o root -g root -m 0755 "$asset_root/deploy/scripts/deploy-mk8-certificate" /usr/local/sbin/deploy-mk8-certificate
install -o root -g root -m 0755 "$asset_root/deploy/scripts/deploy-admin-certificate" /usr/local/sbin/deploy-admin-certificate
install -o root -g root -m 0755 "$asset_root/deploy/scripts/install-build-environment" /usr/local/sbin/install-build-environment
install -o root -g root -m 0755 "$asset_root/deploy/scripts/install-mail-stack" /usr/local/sbin/install-mail-stack
install -o root -g root -m 0755 "$asset_root/deploy/scripts/install-native-release" /usr/local/sbin/install-native-release
install -o root -g root -m 0755 "$asset_root/deploy/scripts/mk8-build" /usr/local/sbin/mk8-build
install -o root -g root -m 0755 "$asset_root/deploy/scripts/mk8-domain" /usr/local/sbin/mk8-domain
install -o root -g root -m 0755 "$asset_root/deploy/scripts/deploy-mk8-domain-certificate" /usr/local/sbin/deploy-mk8-domain-certificate
install -o root -g root -m 0755 "$asset_root/deploy/scripts/mk8email" /usr/local/sbin/mk8email
install -o root -g root -m 0755 "$asset_root/deploy/scripts/verify-host-prerequisites" /usr/local/sbin/verify-host-prerequisites
install -o root -g root -m 0755 "$asset_root/deploy/scripts/prune-native-releases" /usr/local/sbin/prune-native-releases
install -d -o root -g root -m 0755 /usr/local/share/mk8email/prerequisites
install -o root -g root -m 0644 "$asset_root/deploy/prerequisites/debian-13-runtime.txt" \
    /usr/local/share/mk8email/prerequisites/debian-13-runtime.txt
install -o root -g root -m 0644 "$asset_root/deploy/prerequisites/debian-13-sources.list" \
    /usr/local/share/mk8email/prerequisites/debian-13-sources.list
install -o root -g root -m 0644 "$asset_root/deploy/prerequisites/debian.sources" \
    /usr/local/share/mk8email/prerequisites/debian.sources
install -d -o root -g root -m 0755 /usr/local/share/mk8email/domain-templates
install -o root -g root -m 0644 "$asset_root/deploy/domain-templates/autoconfig.xml" \
    /usr/local/share/mk8email/domain-templates/autoconfig.xml
install -o root -g root -m 0644 "$asset_root/deploy/domain-templates/mta-sts.txt" \
    /usr/local/share/mk8email/domain-templates/mta-sts.txt
install -o root -g root -m 0644 "$asset_root/deploy/domain-templates/nginx-domain.conf" \
    /usr/local/share/mk8email/domain-templates/nginx-domain.conf
install -d -o root -g root -m 0755 /usr/local/share/mk8email/distributed
install -o root -g root -m 0644 \
    "$asset_root/deploy/native/mk8email.distributed.config.example.json" \
    /usr/local/share/mk8email/distributed/config.example.json

install -d -o root -g root -m 0755 /usr/local/lib/mk8email/tests
install -o root -g root -m 0755 "$asset_root/deploy/tests/backup_restore_smoke" /usr/local/lib/mk8email/tests/backup_restore_smoke
install -o root -g root -m 0755 "$asset_root/deploy/tests/backup_continuity_smoke" /usr/local/lib/mk8email/tests/backup_continuity_smoke
install -o root -g root -m 0755 "$asset_root/deploy/tests/build_environment_smoke" /usr/local/lib/mk8email/tests/build_environment_smoke
install -o root -g root -m 0755 "$asset_root/deploy/tests/aide_alert_smoke" /usr/local/lib/mk8email/tests/aide_alert_smoke
install -o root -g root -m 0755 "$asset_root/deploy/tests/apt_sources_smoke" /usr/local/lib/mk8email/tests/apt_sources_smoke
install -o root -g root -m 0755 "$asset_root/deploy/tests/dashboard_smoke.py" /usr/local/lib/mk8email/tests/dashboard_smoke.py
install -o root -g root -m 0755 "$asset_root/deploy/tests/certificate_deploy_smoke" /usr/local/lib/mk8email/tests/certificate_deploy_smoke
install -o root -g root -m 0755 "$asset_root/deploy/tests/disruption_smoke" /usr/local/lib/mk8email/tests/disruption_smoke
install -o root -g root -m 0755 "$asset_root/deploy/tests/host_hardening_smoke" /usr/local/lib/mk8email/tests/host_hardening_smoke
install -o root -g root -m 0755 "$asset_root/deploy/tests/management_cli_smoke" /usr/local/lib/mk8email/tests/management_cli_smoke
install -o root -g root -m 0755 "$asset_root/deploy/tests/multi_domain_smoke" /usr/local/lib/mk8email/tests/multi_domain_smoke
install -o root -g root -m 0755 "$asset_root/deploy/tests/multi_domain_smoke.py" /usr/local/lib/mk8email/tests/multi_domain_smoke.py
install -o root -g root -m 0755 "$asset_root/deploy/tests/native_release_smoke" /usr/local/lib/mk8email/tests/native_release_smoke
install -o root -g root -m 0755 "$asset_root/deploy/tests/mail_smoke.py" /usr/local/lib/mk8email/tests/mail_smoke.py
install -o root -g root -m 0755 "$asset_root/deploy/tests/prerequisites_smoke" /usr/local/lib/mk8email/tests/prerequisites_smoke
install -o root -g root -m 0755 "$asset_root/deploy/tests/release_retention_smoke" /usr/local/lib/mk8email/tests/release_retention_smoke
install -o root -g root -m 0755 "$asset_root/deploy/tests/tls_smoke" /usr/local/lib/mk8email/tests/tls_smoke

install -o root -g root -m 0644 "$asset_root/deploy/tmpfiles/mk8-mail.conf" /etc/tmpfiles.d/mk8-mail.conf
install -o root -g root -m 0644 "$asset_root/deploy/logrotate/mk8-mail" /etc/logrotate.d/mk8-mail
install -o root -g root -m 0644 "$asset_root/deploy/systemd/mk8-backup.service" /etc/systemd/system/mk8-backup.service
install -o root -g root -m 0644 "$asset_root/deploy/systemd/mk8-backup.timer" /etc/systemd/system/mk8-backup.timer
systemd-tmpfiles --create /etc/tmpfiles.d/mk8-mail.conf

install -o root -g root -m 0644 "$asset_root/deploy/nginx/00-mk8-security.conf" /etc/nginx/conf.d/00-mk8-security.conf
install -o root -g root -m 0644 "$asset_root/deploy/nginx/mk8-admin.conf" /etc/nginx/sites-available/mk8-admin.conf
install -o root -g root -m 0644 "$asset_root/deploy/nginx/mk8-services.conf" /etc/nginx/sites-available/mk8-services.conf
ln -sfn /etc/nginx/sites-available/mk8-admin.conf /etc/nginx/sites-enabled/mk8-admin.conf
ln -sfn /etc/nginx/sites-available/mk8-services.conf /etc/nginx/sites-enabled/mk8-services.conf
install -d -o root -g root -m 0755 /etc/nginx/mk8email-domains.d /var/www/mk8email-domains
/usr/local/sbin/mk8-domain prepare mk8n mk8n.com
primary_domain_certificate=/etc/mk8email/domains/mk8n.com/tls/fullchain.pem
primary_domain_private_key=/etc/mk8email/domains/mk8n.com/tls/privkey.pem
primary_domain_nginx=/etc/nginx/mk8email-domains.d/mk8n.com.conf
if [ ! -e "$primary_domain_certificate" ] \
    && [ ! -e "$primary_domain_private_key" ] \
    && [ ! -e "$primary_domain_nginx" ]; then
    primary_lineage=$(mktemp -d /run/mk8-primary-lineage.XXXXXX)
    install -o root -g root -m 0644 /etc/mk8email/tls/fullchain.pem "$primary_lineage/fullchain.pem"
    install -o root -g root -m 0600 /etc/mk8email/tls/privkey.pem "$primary_lineage/privkey.pem"
    RENEWED_LINEAGE=$primary_lineage /usr/local/sbin/deploy-mk8-domain-certificate mk8n.com
    rm -rf -- "$primary_lineage"
    primary_lineage=
elif [ ! -s "$primary_domain_certificate" ] \
    || [ ! -s "$primary_domain_private_key" ] \
    || [ ! -s "$primary_domain_nginx" ]; then
    printf '%s\n' "The primary domain discovery state is incomplete." >&2
    exit 1
fi
/usr/local/sbin/mk8-domain rebuild-web-configs
install -o root -g root -m 0644 "$asset_root/deploy/fail2ban/90-mk8-server.local" /etc/fail2ban/jail.d/90-mk8-server.local
install -d -o root -g root -m 0755 /etc/fail2ban/filter.d
install -o root -g root -m 0644 \
    "$asset_root/deploy/fail2ban/filter.d/mk8email-auth.conf" \
    /etc/fail2ban/filter.d/mk8email-auth.conf
install -o root -g root -m 0755 "$asset_root/deploy/nftables/mk8-server.nft" /etc/nftables.conf

if ! python3 - /etc/mk8email/mk8email.config.json <<'PY'
import json
import sys

with open(sys.argv[1], encoding="utf-8") as stream:
    configuration = json.load(stream)
dkim = configuration.get("Dkim", {})
valid = dkim.get("EnableSigning") is False and dkim.get("PrivateKeyPath") is None
raise SystemExit(0 if valid else 1)
PY
then
    printf '%s\n' "The production application must not use its single-domain DKIM signer." >&2
    exit 1
fi

rspamadm configtest --config=/etc/rspamd/rspamd.conf --strict >/dev/null
clamconf --config-dir=/etc/clamav --non-default >/dev/null
nginx -t
nft -c -f /etc/nftables.conf
fail2ban-client -t
aide --config=/etc/aide/aide.conf --config-check

if [ "$legacy_key_migrated" = true ]; then
    rm -f -- /etc/mk8email/dkim/s202609.private.pem
fi

systemctl unmask mk8email.service rspamd.service clamav-daemon.service \
    clamav-daemon.socket clamav-freshclam.service valkey-server.service
systemctl mask postfix.service dovecot.service
systemctl daemon-reload
systemd-analyze verify mk8email-admin.service mk8email-gateway.service \
    mk8email-worker.service mk8email-worker-drain.service \
    mk8email-wake.service mk8email-worker.path \
    mk8email-worker-maintenance.timer \
    mk8-backup.service mk8-backup.timer \
    mk8-mail-health.service mk8-mail-health.timer mk8email.service rspamd.service \
    clamav-daemon.service clamav-freshclam.service valkey-server.service \
    dailyaidecheck.service dailyaidecheck.timer
nft -f /etc/nftables.conf
systemctl reload nginx.service
systemctl restart fail2ban.service

if runuser -u postgres -- psql --dbname=mk8email --no-psqlrc --tuples-only --no-align \
    --command="SELECT to_regclass('public.companies') IS NOT NULL" | grep -qx t; then
    /usr/local/sbin/configure-mail-database-access
fi

printf '%s\n' "Native mail assets are installed. The public mail service remains inactive."

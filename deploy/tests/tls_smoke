#!/bin/sh
set -eu

if [ "$#" -gt 2 ]; then
    printf '%s\n' "Usage: tls_smoke [CA_FILE [HOSTNAME]]" >&2
    exit 2
fi

ca_file=${1:-}
hostname=${2:-email.mk8n.com}

reject_protocol() {
    label=$1
    shift
    if timeout 15 openssl s_client -brief "$@" </dev/null >/dev/null 2>&1; then
        echo "$label accepted a prohibited TLS protocol." >&2
        exit 1
    fi
}

accept_protocol() {
    label=$1
    protocol=$2
    shift 2
    if [ -n "$ca_file" ]; then
        output=$(timeout 15 openssl s_client -brief -verify_return_error \
            -CAfile "$ca_file" -verify_hostname "$hostname" "$@" </dev/null 2>&1)
        printf '%s\n' "$output" | grep -F "Verification: OK" >/dev/null
    else
        output=$(timeout 15 openssl s_client -brief "$@" </dev/null 2>&1)
    fi
    printf '%s\n' "$output" | grep -F "Protocol version: $protocol" >/dev/null
    echo "$label accepted $protocol."
}

reject_protocol "IMAPS" -connect 127.0.0.1:993 -tls1
reject_protocol "submissions" -connect 127.0.0.1:465 -tls1
reject_protocol "submission" -connect 127.0.0.1:587 -starttls smtp -tls1
reject_protocol "POP3S" -connect 127.0.0.1:995 -tls1
reject_protocol "POP3 STLS" -connect 127.0.0.1:110 -starttls pop3 -tls1
reject_protocol "ManageSieve STARTTLS" -connect 127.0.0.1:4190 -starttls sieve -tls1

accept_protocol "IMAPS" "TLSv1.2" -connect 127.0.0.1:993 -tls1_2
accept_protocol "IMAPS" "TLSv1.3" -connect 127.0.0.1:993 -tls1_3
accept_protocol "submissions" "TLSv1.2" -connect 127.0.0.1:465 -tls1_2
accept_protocol "submissions" "TLSv1.3" -connect 127.0.0.1:465 -tls1_3
accept_protocol "submission" "TLSv1.2" -connect 127.0.0.1:587 -starttls smtp -tls1_2
accept_protocol "submission" "TLSv1.3" -connect 127.0.0.1:587 -starttls smtp -tls1_3
accept_protocol "POP3S" "TLSv1.2" -connect 127.0.0.1:995 -tls1_2
accept_protocol "POP3S" "TLSv1.3" -connect 127.0.0.1:995 -tls1_3
accept_protocol "POP3 STLS" "TLSv1.2" -connect 127.0.0.1:110 -starttls pop3 -tls1_2
accept_protocol "POP3 STLS" "TLSv1.3" -connect 127.0.0.1:110 -starttls pop3 -tls1_3
accept_protocol "ManageSieve STARTTLS" "TLSv1.2" -connect 127.0.0.1:4190 -starttls sieve -tls1_2
accept_protocol "ManageSieve STARTTLS" "TLSv1.3" -connect 127.0.0.1:4190 -starttls sieve -tls1_3

echo "TLS protocol tests passed."

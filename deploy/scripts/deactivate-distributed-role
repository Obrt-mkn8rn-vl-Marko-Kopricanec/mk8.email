#!/bin/sh
set -eu

if [ "$(id -u)" -ne 0 ] || [ "$#" -ne 1 ]; then
    printf '%s\n' "Usage: deactivate-distributed-role gateway|worker" >&2
    exit 2
fi

case "$1" in
    gateway) unit=mk8email-gateway.service ;;
    worker)
        unit=mk8email-worker.path
        wake_unit=mk8email-wake.service
        maintenance_timer=mk8email-worker-maintenance.timer
        drain_unit=mk8email-worker-drain.service
        resident_unit=mk8email-worker.service
        offsite_timer=mk8email-offsite-backup.timer
        offsite_unit=mk8email-offsite-backup.service
        ;;
    *)
        printf '%s\n' "Usage: deactivate-distributed-role gateway|worker" >&2
        exit 2
        ;;
esac

exec 9>/run/lock/mk8email-distributed-activation.lock
flock --exclusive --nonblock 9 || {
    printf '%s\n' "Another distributed role activation is running." >&2
    exit 1
}

if [ "$1" = worker ]; then
    offsite_state=$(systemctl is-enabled "$offsite_timer" 2>/dev/null || true)
    if [ "$offsite_state" != not-found ]; then
        systemctl stop "$offsite_timer"
        systemctl disable "$offsite_timer"
        systemctl stop "$offsite_unit"
    fi
    systemctl stop "$maintenance_timer"
    systemctl disable "$maintenance_timer"
fi
systemctl stop "$unit"
systemctl disable "$unit"
if [ "$1" = worker ]; then
    systemctl stop "$drain_unit" "$wake_unit" "$resident_unit"
    systemctl disable "$wake_unit" "$resident_unit"
fi
printf 'The distributed %s role is inactive.\n' "$1"

#!/bin/sh
set -eu

PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH

if [ "$(id -u)" -ne 0 ] || [ "$#" -ne 0 ]; then
    printf '%s\n' "Usage: ensure-wake-service-account" >&2
    exit 2
fi

getent group mk8wake >/dev/null || groupadd --system mk8wake
if ! getent passwd mk8wake >/dev/null; then
    useradd --system --gid mk8wake --no-create-home \
        --home-dir /nonexistent --shell /usr/sbin/nologin mk8wake
fi

if [ "$(id -u mk8wake)" -eq 0 ] \
    || [ "$(id -u mk8wake)" -ge 1000 ] \
    || [ "$(id -gn mk8wake)" != mk8wake ] \
    || [ "$(id -nG mk8wake)" != mk8wake ] \
    || [ "$(getent passwd mk8wake | cut -d: -f6)" != /nonexistent ] \
    || [ "$(getent passwd mk8wake | cut -d: -f7)" != /usr/sbin/nologin ] \
    || [ -n "$(getent group mk8wake | cut -d: -f4)" ]; then
    printf '%s\n' "The Wake service identity has unsafe privileges or membership." >&2
    exit 1
fi
wake_gid=$(id -g mk8wake)
other_primary_users=$(getent passwd | awk -F: -v gid="$wake_gid" \
    '$4 == gid && $1 != "mk8wake" { print $1 }')
if [ -n "$other_primary_users" ]; then
    printf '%s\n' "Another account shares the Wake secret-reading group." >&2
    exit 1
fi

<?xml version="1.0" encoding="UTF-8"?>
<clientConfig version="1.2">
  <emailProvider id="mk8n.com">
    <domain>mk8n.com</domain>
    <displayName>mk8n Mail</displayName>
    <displayShortName>mk8n</displayShortName>
    <oAuth2>
      <issuer>https://email.mk8n.com</issuer>
      <scope>offline_access imap smtp pop jmap dav sieve</scope>
      <authURL>https://email.mk8n.com/oauth/authorize</authURL>
      <tokenURL>https://email.mk8n.com/oauth/token</tokenURL>
      <clientID>thunderbird</clientID>
    </oAuth2>
    <incomingServer type="jmap">
      <url>https://email.mk8n.com/.well-known/jmap</url>
      <authentication>OAuth2</authentication>
      <authentication system="http">Basic</authentication>
      <username>%EMAILADDRESS%</username>
    </incomingServer>
    <incomingServer type="imap">
      <hostname>email.mk8n.com</hostname>
      <port>993</port>
      <socketType>SSL</socketType>
      <authentication>OAuth2</authentication>
      <authentication>password-cleartext</authentication>
      <username>%EMAILADDRESS%</username>
    </incomingServer>
    <incomingServer type="pop3">
      <hostname>email.mk8n.com</hostname>
      <port>995</port>
      <socketType>SSL</socketType>
      <authentication>OAuth2</authentication>
      <authentication>password-cleartext</authentication>
      <username>%EMAILADDRESS%</username>
    </incomingServer>
    <outgoingServer type="smtp">
      <hostname>email.mk8n.com</hostname>
      <port>587</port>
      <socketType>STARTTLS</socketType>
      <authentication>OAuth2</authentication>
      <authentication>password-cleartext</authentication>
      <username>%EMAILADDRESS%</username>
    </outgoingServer>
  </emailProvider>
  <calendar type="caldav">
    <url>https://email.mk8n.com/.well-known/caldav</url>
    <authentication>OAuth2</authentication>
    <authentication system="http">Basic</authentication>
    <username>%EMAILADDRESS%</username>
  </calendar>
  <addressbook type="carddav">
    <url>https://email.mk8n.com/.well-known/carddav</url>
    <authentication>OAuth2</authentication>
    <authentication system="http">Basic</authentication>
    <username>%EMAILADDRESS%</username>
  </addressbook>
</clientConfig>

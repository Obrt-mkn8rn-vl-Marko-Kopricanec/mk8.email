#!/bin/sh
set -eu

test "$#" -eq 1
backup_directory=$1
test_database=mk8email_restore_smoke
database_created=false

case "$backup_directory" in
    /var/backups/mk8/20??????T??????Z) ;;
    *)
        echo "The backup path is not valid." >&2
        exit 64
        ;;
esac

test -d "$backup_directory"
test "$test_database" = mk8email_restore_smoke

cleanup() {
    if [ "$database_created" = true ]; then
        runuser -u postgres -- dropdb --force "$test_database"
    fi
}
trap cleanup EXIT HUP INT TERM

if runuser -u postgres -- psql --quiet --tuples-only --no-align \
    --dbname=postgres --command="SELECT 1 FROM pg_database WHERE datname = '$test_database'" \
    | grep -q 1; then
    echo "The restore test database already exists." >&2
    exit 1
fi

(cd "$backup_directory" && sha256sum --quiet --check SHA256SUMS)
pg_restore --list "$backup_directory/mk8email.dump" >/dev/null
test -s "$backup_directory/backup-metadata.txt"
grep -Fx 'mail_services_interrupted=false' "$backup_directory/backup-metadata.txt" >/dev/null
grep -Eq '^valkey_was_active=(true|false)$' "$backup_directory/backup-metadata.txt"
grep -Eq '^valkey_interruption_milliseconds=[0-9]+$' "$backup_directory/backup-metadata.txt"
valkey-check-rdb "$backup_directory/valkey/dump.rdb" >/dev/null
tar --list --gzip --file="$backup_directory/configuration.tar.gz" \
    | grep -F 'etc/NetworkManager/system-connections/' >/dev/null
tar --list --gzip --file="$backup_directory/configuration.tar.gz" \
    | grep -F 'etc/apt/' >/dev/null
tar --list --gzip --file="$backup_directory/configuration.tar.gz" \
    | grep -Fx 'etc/apt/sources.list.d/debian.sources' >/dev/null
if tar --list --gzip --file="$backup_directory/configuration.tar.gz" \
    | grep -Fx 'etc/apt/sources.list' >/dev/null; then
    legacy_source_size=$(tar --extract --to-stdout --gzip \
        --file="$backup_directory/configuration.tar.gz" \
        etc/apt/sources.list | wc -c)
    test "$legacy_source_size" -eq 0
fi
tar --list --gzip --file="$backup_directory/configuration.tar.gz" \
    | grep -Fx 'var/lib/aide/aide.db' >/dev/null
tar --list --gzip --file="$backup_directory/configuration.tar.gz" \
    | grep -Fx 'etc/aide/aide.conf.d/90_mk8_dynamic_data' >/dev/null
tar --list --gzip --file="$backup_directory/configuration.tar.gz" \
    | grep -Fx 'etc/default/smartmontools' >/dev/null
tar --list --gzip --file="$backup_directory/configuration.tar.gz" \
    | grep -Fx 'etc/smartd.conf' >/dev/null
tar --list --gzip --file="$backup_directory/configuration.tar.gz" \
    | grep -Fx 'usr/local/sbin/verify-host-prerequisites' >/dev/null
tar --list --gzip --file="$backup_directory/configuration.tar.gz" \
    | grep -Fx 'usr/local/sbin/configure-apt-sources' >/dev/null
tar --list --gzip --file="$backup_directory/configuration.tar.gz" \
    | grep -Fx 'usr/local/sbin/mk8email' >/dev/null
tar --list --gzip --file="$backup_directory/configuration.tar.gz" \
    | grep -Fx 'usr/local/sbin/activate-distributed-role' >/dev/null
tar --list --gzip --file="$backup_directory/configuration.tar.gz" \
    | grep -Fx 'usr/local/sbin/install-distributed-role' >/dev/null
tar --list --gzip --file="$backup_directory/configuration.tar.gz" \
    | grep -Fx 'usr/local/sbin/deactivate-distributed-role' >/dev/null
tar --list --gzip --file="$backup_directory/configuration.tar.gz" \
    | grep -Fx 'usr/local/sbin/mk8-domain' >/dev/null
tar --list --gzip --file="$backup_directory/configuration.tar.gz" \
    | grep -Fx 'usr/local/sbin/deploy-mk8-domain-certificate' >/dev/null
tar --list --gzip --file="$backup_directory/configuration.tar.gz" \
    | grep -Fx 'usr/local/sbin/prune-native-releases' >/dev/null
tar --list --gzip --file="$backup_directory/configuration.tar.gz" \
    | grep -Fx 'etc/systemd/coredump.conf.d/90-mk8-server.conf' >/dev/null
tar --list --gzip --file="$backup_directory/configuration.tar.gz" \
    | grep -Fx 'etc/systemd/system/bluetooth.service' >/dev/null
tar --list --gzip --file="$backup_directory/configuration.tar.gz" \
    | grep -Fx 'etc/systemd/system/default.target' >/dev/null
tar --list --gzip --file="$backup_directory/configuration.tar.gz" \
    | grep -Fx 'etc/systemd/system/mk8email-gateway.service' >/dev/null
tar --list --gzip --file="$backup_directory/configuration.tar.gz" \
    | grep -Fx 'etc/systemd/system/mk8email-worker.service' >/dev/null
tar --list --gzip --file="$backup_directory/configuration.tar.gz" \
    | grep -Fx 'usr/local/lib/mk8email/tests/host_hardening_smoke' >/dev/null
tar --list --gzip --file="$backup_directory/configuration.tar.gz" \
    | grep -Fx 'usr/local/lib/mk8email/tests/apt_sources_smoke' >/dev/null
tar --list --gzip --file="$backup_directory/configuration.tar.gz" \
    | grep -Fx 'usr/local/lib/mk8email/tests/certificate_deploy_smoke' >/dev/null
tar --list --gzip --file="$backup_directory/configuration.tar.gz" \
    | grep -Fx 'usr/local/lib/mk8email/tests/management_cli_smoke' >/dev/null
tar --list --gzip --file="$backup_directory/configuration.tar.gz" \
    | grep -Fx 'usr/local/lib/mk8email/tests/multi_domain_smoke' >/dev/null
tar --list --gzip --file="$backup_directory/configuration.tar.gz" \
    | grep -Fx 'usr/local/lib/mk8email/tests/native_release_smoke' >/dev/null
tar --list --gzip --file="$backup_directory/configuration.tar.gz" \
    | grep -Fx 'usr/local/lib/mk8email/tests/release_retention_smoke' >/dev/null
tar --list --gzip --file="$backup_directory/configuration.tar.gz" \
    | grep -Fx 'usr/local/share/mk8email/prerequisites/debian-13-runtime.txt' >/dev/null
tar --list --gzip --file="$backup_directory/configuration.tar.gz" \
    | grep -Fx 'usr/local/share/mk8email/prerequisites/debian.sources' >/dev/null
tar --list --gzip --file="$backup_directory/configuration.tar.gz" \
    | grep -Fx 'usr/local/share/mk8email/domain-templates/autoconfig.xml' >/dev/null
tar --list --gzip --file="$backup_directory/configuration.tar.gz" \
    | grep -Fx 'usr/local/share/mk8email/domain-templates/nginx-domain.conf' >/dev/null
tar --list --gzip --file="$backup_directory/configuration.tar.gz" \
    | grep -Fx 'usr/local/share/mk8email/distributed/config.example.json' >/dev/null
tar --list --gzip --file="$backup_directory/configuration.tar.gz" \
    | grep -Fx 'etc/mk8email/domains/mk8n.com/dkim-selector' >/dev/null
tar --list --gzip --file="$backup_directory/configuration.tar.gz" \
    | grep -Fx 'etc/mk8email/secrets/mfa_encryption_key' >/dev/null
tar --list --gzip --file="$backup_directory/configuration.tar.gz" \
    | grep -Fx 'etc/mk8email/secrets/oidc_signing_key.pem' >/dev/null
tar --list --gzip --file="$backup_directory/configuration.tar.gz" \
    | grep -E '^etc/mk8email/dkim/mk8n[.]com/[a-z0-9]+[.]private[.]pem$' >/dev/null
tar --list --gzip --file="$backup_directory/configuration.tar.gz" \
    | grep -Fx 'etc/mk8email/domains/mk8n.com/tls/fullchain.pem' >/dev/null
tar --list --gzip --file="$backup_directory/configuration.tar.gz" \
    | grep -Fx 'etc/nginx/mk8email-domains.d/mk8n.com.conf' >/dev/null
tar --list --gzip --file="$backup_directory/configuration.tar.gz" \
    | grep -Fx 'var/www/mk8email-domains/mk8n.com/autoconfig/mail/config-v1.1.xml' >/dev/null
test -s "$backup_directory/debian-packages.tsv"
test -s "$backup_directory/debian-manual-packages.txt"
test -s "$backup_directory/os-release"
test -s "$backup_directory/kernel.txt"

runuser -u postgres -- createdb --template=template0 "$test_database"
database_created=true
runuser -u postgres -- pg_restore --exit-on-error --no-owner --no-acl \
    --dbname="$test_database" < "$backup_directory/mk8email.dump"

account_count=$(runuser -u postgres -- psql --quiet --tuples-only --no-align \
    --dbname="$test_database" \
    --command="SELECT count(*) FROM users WHERE is_active AND username IN ('admin@mk8n.com', 'mk8n@mk8n.com')")
test "$account_count" -eq 2

catchall_count=$(runuser -u postgres -- psql --quiet --tuples-only --no-align \
    --dbname="$test_database" \
    --command="SELECT count(*) FROM inboxes source JOIN addresses source_domain ON source_domain.id = source.address_id JOIN inboxes target ON target.id = source.alias_for_inbox_id JOIN addresses target_domain ON target_domain.id = target.address_id WHERE source.name = '*' AND source_domain.domain = 'mk8n.com' AND target.name = 'mk8n' AND target_domain.domain = 'mk8n.com'")
test "$catchall_count" -eq 1

echo "Backup checksums, archives, accounts, and catch-all restore tests passed."

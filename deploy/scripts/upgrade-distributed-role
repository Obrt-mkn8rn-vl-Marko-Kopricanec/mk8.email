#!/bin/sh
set -eu

# Refuse tracked templates before any target or service mutation.
if LC_ALL=C grep -Eq '[@]{2}MK8_[A-Z0-9_]+[@]{2}' "$0"; then
    printf '%s\n' "Render required deployment inputs before using this template." >&2
    exit 2
fi

PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
export DOTNET_ENVIRONMENT=Production
export DOTNET_EnableDiagnostics=0

if [ "$(id -u)" -ne 0 ] || [ "$#" -ne 2 ]; then
    printf '%s\n' "Usage: upgrade-distributed-role gateway|worker STAGED_RELEASE_ID" >&2
    exit 2
fi
role=$1

case "$1" in
    gateway)
        unit=mk8email-gateway.service
        other_units='mk8email-worker.service mk8email-worker.path mk8email-wake.service mk8email-worker-drain.service mk8email-worker-maintenance.timer mk8email-offsite-backup.service mk8email-offsite-backup.timer'
        config=/etc/mk8email/mk8email.gateway.config.json
        executable=admin/mk8.email.Gateway.dll
        validate=--validate-gateway-config
        probe=--probe-gateway-backends
        ;;
    worker)
        unit=mk8email-worker.path
        wake_unit=mk8email-wake.service
        maintenance_timer=mk8email-worker-maintenance.timer
        drain_unit=mk8email-worker-drain.service
        resident_unit=mk8email-worker.service
        offsite_timer=mk8email-offsite-backup.timer
        offsite_unit=mk8email-offsite-backup.service
        wake_connection=/etc/mk8email/mk8email.wake.connection
        other_units=mk8email-gateway.service
        config=/etc/mk8email/mk8email.worker.config.json
        executable=worker/mk8.email.Application.Worker.dll
        validate=--validate-worker-config
        probe=--probe-worker-backends
        ;;
    *)
        printf '%s\n' "The distributed role must be gateway or worker." >&2
        exit 2
        ;;
esac

release_id=$2
if [ "${#release_id}" -ne 16 ] \
    || ! printf '%s\n' "$release_id" | grep -Eq '^[0-9a-f]{16}$'; then
    printf '%s\n' "The staged release identifier must be 16 lowercase hexadecimal characters." >&2
    exit 2
fi

fail() {
    printf '%s\n' "$1" >&2
    exit 1
}

validate_release() {
    release=$1
    expected_id=$2
    if [ ! -d "$release" ] || [ -L "$release" ]; then
        fail "A release directory is missing or unsafe."
    fi
    [ "$(readlink -f -- "$release")" = "$release" ] \
        || fail "A release directory does not resolve to itself."
    [ "$(stat -c '%U:%G %a' "$release")" = 'root:root 555' ] \
        || fail "A release directory has unsafe metadata."
    unsafe_entry=$(find "$release" \( ! -type f -a ! -type d -o ! -user root \
        -o -perm /022 -o -type f -links +1 \) -print -quit) \
        || fail "A release could not be inspected."
    if [ -n "$unsafe_entry" ]; then
        fail "A release contains an unsafe entry."
    fi
    [ -f "$release/.mk8email-release" ] \
        || fail "A release provenance record is missing."
    grep -Fx "release_id=$expected_id" "$release/.mk8email-release" >/dev/null \
        || fail "A release provenance record has the wrong identifier."
    if [ ! -f "$release/cli/mk8.email.Application.CLI.dll" ] \
        || [ ! -f "$release/$executable" ]; then
        fail "A release is missing the selected role or management CLI."
    fi
    if [ "$role" = worker ] \
        && [ ! -f "$release/wake/mk8.email.Wake.dll" ]; then
        fail "A release is missing the independent Wake executable."
    fi
}

current=/opt/mk8email/current
release_root=/opt/mk8email/releases
staged_release=$release_root/$release_id
temporary_link=/opt/mk8email/.current-upgrade-$$

exec 9>/run/lock/mk8email-distributed-activation.lock
flock --exclusive --nonblock 9 \
    || fail "Another distributed role operation is running."

if [ ! -L "$current" ] \
    || [ "$(stat -c '%U:%G' "$current")" != 'root:root' ]; then
    fail "The active release link is missing or unsafe."
fi
previous_release=$(readlink -f -- "$current")
[ "$(dirname -- "$previous_release")" = "$release_root" ] \
    || fail "The active release is outside the release directory."
previous_id=${previous_release##*/}
if [ "${#previous_id}" -ne 16 ] \
    || ! printf '%s\n' "$previous_id" | grep -Eq '^[0-9a-f]{16}$'; then
    fail "The active release identifier is invalid."
fi
[ "$previous_release" != "$staged_release" ] \
    || fail "The staged release is already active."
validate_release "$previous_release" "$previous_id"
validate_release "$staged_release" "$release_id"

marker=/etc/mk8email/distributed-ready
if [ -L "$marker" ] || [ ! -f "$marker" ] \
    || [ "$(stat -c '%U:%G %a %h' "$marker" 2>/dev/null || true)" != 'root:root 600 1' ]; then
    fail "The distributed readiness marker is missing or unsafe."
fi
if [ -L "$config" ] || [ ! -f "$config" ] \
    || [ "$(stat -c '%U:%G %a %h' "$config" 2>/dev/null || true)" != 'root:mk8email 640 1' ]; then
    fail "The role configuration is missing or unsafe."
fi
if [ "$role" = worker ]; then
    if [ -L "$wake_connection" ] || [ ! -f "$wake_connection" ] \
        || [ "$(stat -c '%U:%G %a %h' "$wake_connection" 2>/dev/null || true)" \
            != 'root:mk8wake 640 1' ]; then
        fail "The dedicated Wake connection file is missing or unsafe."
    fi
    systemctl is-active --quiet "$wake_unit" \
        || fail "The Wake monitor must be active before a Worker upgrade."
    [ "$(systemctl is-enabled "$wake_unit" 2>/dev/null || true)" = enabled ] \
        || fail "The Wake monitor must be enabled before a Worker upgrade."
    systemctl is-active --quiet "$maintenance_timer" \
        || fail "The Worker maintenance timer must be active before an upgrade."
    [ "$(systemctl is-enabled "$maintenance_timer" 2>/dev/null || true)" = enabled ] \
        || fail "The Worker maintenance timer must be enabled before an upgrade."
    if systemctl is-active --quiet "$resident_unit" \
        || [ "$(systemctl is-enabled "$resident_unit" 2>/dev/null || true)" = enabled ]; then
        fail "A resident Worker cannot be upgraded as an on-demand role."
    fi
    if systemctl is-active --quiet "$offsite_timer" \
        || systemctl is-active --quiet "$offsite_unit" \
        || [ "$(systemctl is-enabled "$offsite_timer" 2>/dev/null || true)" = enabled ]; then
        fail "Pause the off-site backup timer and job before upgrading the Worker role."
    fi
fi
systemctl is-active --quiet "$unit" \
    || fail "The selected role must be active before an upgrade."
[ "$(systemctl is-enabled "$unit" 2>/dev/null || true)" = enabled ] \
    || fail "The selected role must be enabled before an upgrade."
for other_unit in $other_units; do
    other_state=$(systemctl is-enabled "$other_unit" 2>/dev/null || true)
    if systemctl is-active --quiet "$other_unit"; then
        fail "A shared-host role is present; use the coordinated production upgrade path."
    fi
    case "$other_state" in
        disabled|not-found|masked|static) ;;
        *) fail "A shared-host role is enabled or has an unsafe unit state." ;;
    esac
done
for legacy_unit in mk8email.service mk8email-admin.service; do
    if systemctl is-active --quiet "$legacy_unit"; then
        fail "A legacy mail unit is active."
    fi
    legacy_state=$(systemctl is-enabled "$legacy_unit" 2>/dev/null || true)
    case "$legacy_state" in
        disabled|not-found|masked) ;;
        *) fail "A legacy mail unit is enabled or has an unsafe unit state." ;;
    esac
done

staged_cli=$staged_release/cli/mk8.email.Application.CLI.dll
timeout 45s runuser -u mk8email -- /usr/bin/dotnet "$staged_cli" "$validate" "$config" \
    || fail "The staged role configuration failed validation."
timeout 45s runuser -u mk8email -- /usr/bin/dotnet "$staged_cli" "$probe" "$config" \
    || fail "The staged PostgreSQL or Azure Blob backend canary failed."
if [ "$role" = worker ]; then
    timeout 20s runuser -u mk8wake -- /usr/bin/dotnet \
        "$previous_release/wake/mk8.email.Wake.dll" --probe \
        "$wake_connection" /run/mk8email-wake \
        || fail "The prior Wake executable or database role failed its canary."
    prior_wake_schema=$(timeout 45s /usr/bin/dotnet "$staged_cli" \
        --worker-wake-schema-state "$config" "$wake_connection") \
        || fail "The prior Wake schema/permission state could not be captured."
    case "$prior_wake_schema" in
        legacy|receipts) ;;
        *) fail "The prior Wake schema/permission state is unsupported." ;;
    esac
fi

atomic_current() {
    destination=$1
    if [ -e "$temporary_link" ] || [ -L "$temporary_link" ]; then
        return 1
    fi
    ln -s "$destination" "$temporary_link" || return 1
    if ! mv -Tf -- "$temporary_link" "$current"; then
        rm -f -- "$temporary_link"
        return 1
    fi
    sync -f /opt/mk8email
}

stop_selected() {
    if [ "$role" = worker ]; then
        systemctl stop "$maintenance_timer" || return 1
        systemctl stop "$unit" || return 1
        systemctl stop "$wake_unit" || return 1
        systemctl stop "$drain_unit" || return 1
    else
        systemctl stop "$unit" || return 1
    fi
}

start_selected() {
    if [ "$role" = worker ]; then
        systemctl start "$wake_unit" || return 1
        systemctl is-active --quiet "$wake_unit" || return 1
        systemctl start "$unit" || return 1
        systemctl start "$maintenance_timer" || return 1
    else
        systemctl start "$unit" || return 1
    fi
}

wait_ready() {
    ready_cli=$1
    ready_wake=$2
    ready_contract_mode=$3
    ready=false
    attempt=0
    while [ "$attempt" -lt 15 ]; do
        if systemctl is-active --quiet "$unit"; then
            if [ "$unit" = mk8email-gateway.service ]; then
                if curl --silent --fail --max-time 3 --noproxy '*' \
                    --header 'Host: @@MK8_ADMIN_HOST@@' \
                    http://127.0.0.1:8080/health/ready >/dev/null \
                    && timeout 20s runuser -u mk8email -- /usr/bin/dotnet "$ready_cli" \
                        --healthcheck-gateway "$config" >/dev/null \
                    && probe_gateway_contracts; then
                    ready=true
                    break
                fi
            elif systemctl is-active --quiet "$wake_unit" \
                && systemctl is-active --quiet "$maintenance_timer" \
                && ! systemctl is-active --quiet "$resident_unit" \
                && timeout 20s runuser -u mk8wake -- /usr/bin/dotnet \
                    "$ready_wake" --probe "$wake_connection" /run/mk8email-wake \
                    >/dev/null \
                && timeout 45s runuser -u mk8email -- /usr/bin/dotnet \
                    "$ready_cli" --probe-worker-dispatch "$config" >/dev/null; then
                    ready=true
                    break
            fi
        fi
        attempt=$((attempt + 1))
        sleep 2
    done
    [ "$ready" = true ]
}

probe_gateway_contracts() {
    if [ "$ready_contract_mode" = candidate ]; then
        timeout 20s runuser -u mk8email -- /usr/bin/dotnet "$ready_cli" \
            --probe-gateway-dispatch "$config" >/dev/null
    else
        # Restore the prior release using its own Gateway's interpretation.
        # Do not require an older management CLI to recognize a new command.
        curl --silent --fail --max-time 12 --noproxy '*' \
            --header 'Host: @@MK8_ADMIN_HOST@@' \
            http://127.0.0.1:8080/health/application >/dev/null
    fi
}

interrupted=false
switched=false
completed=false
rollback() {
    status=$?
    trap - EXIT HUP INT TERM
    if [ "$completed" != true ] && [ "$interrupted" = true ]; then
        set +e
        stop_selected >/dev/null 2>&1
        stop_status=$?
        if [ "$stop_status" -ne 0 ]; then
            link_status=1
            start_status=1
        else
            schema_status=0
            if [ "$role" = worker ]; then
                timeout 45s /usr/bin/dotnet "$staged_cli" --restore-worker-wake \
                    "$config" "$wake_connection" "$prior_wake_schema"
                schema_status=$?
            fi
            if [ "$schema_status" -ne 0 ]; then
                # Never restart an old binary over committed receipts or incompatible work.
                link_status=1
                start_status=1
            elif [ "$switched" = true ]; then
                atomic_current "$previous_release"
                link_status=$?
            else
                link_status=0
            fi
            if [ "$schema_status" -eq 0 ] && [ "$link_status" -eq 0 ]; then
                start_selected
                start_status=$?
                if [ "$start_status" -eq 0 ]; then
                    wait_ready "$previous_release/cli/mk8.email.Application.CLI.dll" \
                        "$previous_release/wake/mk8.email.Wake.dll" prior
                    start_status=$?
                fi
            else
                start_status=1
            fi
        fi
        if [ "$link_status" -ne 0 ] || [ "$start_status" -ne 0 ]; then
            printf '%s\n' "The prior role could not be restored; immediate operator action is required." >&2
        else
            printf '%s\n' "The prior role was restored after the failed upgrade." >&2
        fi
        set -e
    fi
    if [ -L "$temporary_link" ]; then
        rm -f -- "$temporary_link"
    fi
    exit "$status"
}
trap rollback EXIT
trap 'exit 130' HUP INT TERM

interrupted=true
stop_selected || fail "The selected role could not be stopped."
if [ "$role" = worker ]; then
    MK8EMAIL_CONFIG_FILE="$config" timeout 30m runuser -u mk8email -- /usr/bin/dotnet \
        "$staged_release/$executable" --prepare \
        || fail "The staged Application Worker schema or Azure Blob migration failed."
    timeout 45s /usr/bin/dotnet "$staged_cli" --prepare-worker-wake \
        "$config" "$wake_connection" \
        || fail "The staged Wake scheduling grant preparation failed."
    timeout 20s runuser -u mk8wake -- /usr/bin/dotnet \
        "$staged_release/wake/mk8.email.Wake.dll" --probe \
        "$wake_connection" /run/mk8email-wake \
        || fail "The prepared candidate Wake executable or database role failed its canary."
fi
switched=true
atomic_current "$staged_release" || fail "The staged release could not become current."
start_selected || fail "The upgraded role could not be started."
wait_ready "$staged_cli" "$staged_release/wake/mk8.email.Wake.dll" candidate \
    || fail "The upgraded role did not become ready."

completed=true
trap - EXIT HUP INT TERM
printf 'The distributed %s role is running release %s.\n' "$1" "$release_id"

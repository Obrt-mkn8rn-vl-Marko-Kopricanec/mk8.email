#!/bin/sh
set -eu

export LC_ALL=C
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
umask 077

if [ "$(id -u)" -ne 0 ] || [ "$#" -ne 1 ] || [ "$1" != mail ]; then
    printf '%s\n' "Usage: deploy-mk8-certificate mail" >&2
    exit 2
fi

lineage=${RENEWED_LINEAGE:-/etc/letsencrypt/live/mk8-mail}
destination=/etc/mk8email/tls
required_names="email.mk8n.com"

fail() {
    printf '%s\n' "$1" >&2
    exit 1
}

case "$lineage" in
    /*) ;;
    *) fail "The certificate lineage path must be absolute." ;;
esac

for required_command in flock nginx openssl systemctl timeout; do
    command -v "$required_command" >/dev/null \
        || fail "A required certificate command is missing: $required_command"
done

exec 9>/run/lock/mk8-certificate.lock
flock --exclusive --nonblock 9 \
    || fail "Another certificate deployment is active."

check_lineage_file() {
    checked_file=$1
    private_file=$2
    resolved_file=$(readlink -f -- "$checked_file") \
        || fail "A certificate lineage file cannot be resolved."
    [ -f "$resolved_file" ] \
        || fail "The certificate lineage is incomplete."
    [ ! -L "$resolved_file" ] \
        || fail "A certificate lineage target must be a regular file."
    [ "$(stat -c '%U:%G' "$resolved_file")" = root:root ] \
        || fail "Root must own each certificate lineage file."
    if find "$resolved_file" -prune -perm /022 -print -quit | grep -q .; then
        fail "Another identity can write a certificate lineage file."
    fi
    if [ "$private_file" = true ] \
        && find "$resolved_file" -prune -perm /077 -print -quit | grep -q .; then
        fail "Another identity can read the certificate private key."
    fi
}

check_lineage_file "$lineage/fullchain.pem" false
check_lineage_file "$lineage/privkey.pem" true

work=$(mktemp -d /run/mk8-certificate.XXXXXX)
completed=false
changed=false
nginx_reloaded=false
destination_created=false
certificate_new=$destination/fullchain.pem.mk8-new
private_new=$destination/privkey.pem.mk8-new
certificate_rollback=$destination/fullchain.pem.mk8-rollback
private_rollback=$destination/privkey.pem.mk8-rollback

snapshot_file() {
    source_path=$1
    snapshot_name=$2
    if [ -L "$source_path" ]; then
        fail "A managed certificate path must not be a symbolic link."
    fi
    if [ -e "$source_path" ] && [ ! -f "$source_path" ]; then
        fail "A managed certificate path must be a regular file."
    fi
    if [ -f "$source_path" ]; then
        [ "$(stat -c '%h' "$source_path")" -eq 1 ] \
            || fail "A managed certificate file must not have another hard link."
        cp -p -- "$source_path" "$work/$snapshot_name"
        : > "$work/$snapshot_name.present"
    fi
    : > "$work/$snapshot_name.checked"
}

restore_snapshot() {
    restored_path=$1
    snapshot_name=$2
    rollback_path=$3
    [ -f "$work/$snapshot_name.checked" ] || return 0
    rm -f -- "$rollback_path"
    if [ -f "$work/$snapshot_name.present" ]; then
        cp -p -- "$work/$snapshot_name" "$rollback_path"
        mv -f -- "$rollback_path" "$restored_path"
    else
        rm -f -- "$restored_path"
    fi
}

restore_previous_certificate() {
    restore_status=0
    restore_snapshot "$destination/fullchain.pem" fullchain "$certificate_rollback" \
        || restore_status=1
    restore_snapshot "$destination/privkey.pem" private "$private_rollback" \
        || restore_status=1
    rm -f -- "$certificate_new" "$private_new"
    if [ "$nginx_reloaded" = true ]; then
        nginx -t >/dev/null 2>&1 || restore_status=1
        systemctl reload nginx.service || restore_status=1
    fi
    if [ "$destination_created" = true ]; then
        rmdir "$destination" 2>/dev/null || restore_status=1
    fi
    return "$restore_status"
}

finish() {
    deployment_status=$?
    trap - EXIT HUP INT TERM
    if [ "$completed" != true ] && [ "$changed" = true ]; then
        set +e
        restore_previous_certificate
        rollback_status=$?
        set -e
        if [ "$rollback_status" -eq 0 ]; then
            printf '%s\n' "Certificate deployment failed. The prior certificate was restored." >&2
        else
            printf '%s\n' "Certificate rollback failed. Immediate operator action is required." >&2
        fi
        deployment_status=1
    fi
    case "$work" in
        /run/mk8-certificate.*) rm -rf -- "$work" ;;
    esac
    exit "$deployment_status"
}
trap finish EXIT
trap 'exit 1' HUP INT TERM

openssl x509 -in "$lineage/fullchain.pem" -noout -checkend 1209600
openssl pkey -in "$lineage/privkey.pem" -noout -check </dev/null >/dev/null
for required_name in $required_names; do
    openssl x509 -in "$lineage/fullchain.pem" -noout \
        -checkhost "$required_name" >/dev/null 2>&1 \
        || fail "The certificate does not cover $required_name."
done
openssl x509 -in "$lineage/fullchain.pem" -pubkey -noout \
    | openssl pkey -pubin -outform DER > "$work/certificate-public-key.der"
openssl pkey -in "$lineage/privkey.pem" -pubout -outform DER \
    > "$work/private-public-key.der"
cmp --silent "$work/certificate-public-key.der" "$work/private-public-key.der" \
    || fail "The certificate and private key do not match."
expected_fingerprint=$(openssl x509 -in "$lineage/fullchain.pem" \
    -noout -fingerprint -sha256)

systemctl is-active --quiet nginx.service \
    || fail "nginx must be active before certificate deployment."
systemctl is-active --quiet mk8email.service \
    || fail "mk8.email must be active before certificate deployment."
nginx -t

if [ -L "$destination" ]; then
    fail "The certificate directory must not be a symbolic link."
fi
if [ -e "$destination" ] && [ ! -d "$destination" ]; then
    fail "The certificate path must be a directory."
fi
if [ ! -d "$destination" ]; then
    install -d -o root -g tlskeys -m 0751 "$destination"
    destination_created=true
    changed=true
fi
[ "$(stat -c '%U:%G %a' "$destination")" = "root:tlskeys 751" ] \
    || fail "The certificate directory has unsafe metadata."

snapshot_file "$destination/fullchain.pem" fullchain
snapshot_file "$destination/privkey.pem" private
for pending_path in "$certificate_new" "$private_new" \
    "$certificate_rollback" "$private_rollback"; do
    if [ -e "$pending_path" ] || [ -L "$pending_path" ]; then
        fail "A stale certificate transaction file exists."
    fi
done

changed=true
install -o root -g tlskeys -m 0444 "$lineage/fullchain.pem" "$certificate_new"
install -o root -g tlskeys -m 0440 "$lineage/privkey.pem" "$private_new"
mv -f -- "$certificate_new" "$destination/fullchain.pem"
mv -f -- "$private_new" "$destination/privkey.pem"
sync -f "$destination"

nginx -t
nginx_reloaded=true
systemctl reload nginx.service

probe_certificate() {
    probe_name=$1
    server_name=$2
    shift 2
    probe_output="$work/presented-$probe_name.pem"
    probe_attempt=0
    while [ "$probe_attempt" -lt 5 ]; do
        : > "$probe_output"
        timeout 10 openssl s_client -showcerts -servername "$server_name" "$@" \
            </dev/null > "$probe_output" 2>/dev/null || true
        presented_fingerprint=$(openssl x509 -in "$probe_output" \
            -noout -fingerprint -sha256 2>/dev/null || true)
        if [ "$presented_fingerprint" = "$expected_fingerprint" ]; then
            return 0
        fi
        probe_attempt=$((probe_attempt + 1))
        [ "$probe_attempt" -eq 5 ] || sleep 1
    done
    fail "A local TLS endpoint did not present the new certificate: $probe_name"
}

for required_name in $required_names; do
    probe_certificate "https-$required_name" "$required_name" -connect 127.0.0.1:443
done
probe_certificate smtp email.mk8n.com -starttls smtp -connect 127.0.0.1:25
probe_certificate submissions email.mk8n.com -connect 127.0.0.1:465
probe_certificate submission email.mk8n.com -starttls smtp -connect 127.0.0.1:587
probe_certificate imaps email.mk8n.com -connect 127.0.0.1:993
probe_certificate pop3 email.mk8n.com -starttls pop3 -connect 127.0.0.1:110
probe_certificate pop3s email.mk8n.com -connect 127.0.0.1:995
probe_certificate sieve email.mk8n.com -starttls sieve -connect 127.0.0.1:4190

systemctl is-active --quiet nginx.service
systemctl is-active --quiet mk8email.service
if systemctl is-active --quiet postfix.service \
    || systemctl is-active --quiet dovecot.service; then
    fail "A forbidden mail service is active."
fi

completed=true
printf '%s\n' "The mail certificate is installed and active on each local TLS endpoint."

#!/bin/sh
set -eu

# Refuse tracked templates before any target or service mutation.
if LC_ALL=C grep -Eq '[@]{2}MK8_[A-Z0-9_]+[@]{2}' "$0"; then
    printf '%s\n' "Render required deployment inputs before using this template." >&2
    exit 2
fi

if [ "$(id -u)" -ne 0 ] || [ "$#" -ne 2 ]; then
    printf '%s\n' "Usage: deploy-admin-certificate CERTIFICATE PRIVATE_KEY" >&2
    exit 2
fi

certificate=$1
private_key=$2
test -s "$certificate"
test -s "$private_key"

work=$(mktemp -d /run/mk8-admin-certificate.XXXXXX)
cleanup() {
    case "$work" in
        /run/mk8-admin-certificate.*) rm -rf -- "$work" ;;
    esac
}
trap cleanup EXIT HUP INT TERM

openssl x509 -in "$certificate" -noout -checkend 1209600 >/dev/null
subject_names=$(openssl x509 -in "$certificate" -noout -ext subjectAltName)
printf '%s\n' "$subject_names" | grep -Fq 'DNS:@@MK8_ADMIN_HOST@@'
printf '%s\n' "$subject_names" | grep -Fq 'IP Address:@@MK8_SERVER_IPV4@@'

openssl x509 -in "$certificate" -pubkey -noout \
    | openssl pkey -pubin -outform DER > "$work/certificate-public-key.der"
openssl pkey -in "$private_key" -pubout -outform DER > "$work/private-public-key.der"
if ! cmp --silent "$work/certificate-public-key.der" "$work/private-public-key.der"; then
    printf '%s\n' "The administrator certificate does not match its private key." >&2
    exit 1
fi

install -d -o root -g root -m 0750 /etc/mk8email/admin-tls
install -o root -g root -m 0444 "$certificate" /etc/mk8email/admin-tls/fullchain.pem.new
install -o root -g root -m 0440 "$private_key" /etc/mk8email/admin-tls/privkey.pem.new
mv -f -- /etc/mk8email/admin-tls/fullchain.pem.new /etc/mk8email/admin-tls/fullchain.pem
mv -f -- /etc/mk8email/admin-tls/privkey.pem.new /etc/mk8email/admin-tls/privkey.pem

nginx -t
if systemctl is-active --quiet nginx.service; then
    systemctl reload nginx.service
fi

printf '%s\n' "The administrator certificate is installed."

#!/bin/sh
set -eu

if [ "$(id -u)" -ne 0 ] || [ "$#" -ne 0 ]; then
    printf '%s\n' "Usage: management_cli_smoke" >&2
    exit 2
fi

output=$(mktemp /run/mk8-management-cli.XXXXXX)
trap 'rm -f -- "$output"' EXIT HUP INT TERM
cli_dll=/opt/mk8email/current/cli/mk8.email.Application.CLI.dll

run_failure() {
    expected_status=$1
    shift
    set +e
    timeout 30s "$@" > "$output" 2>&1
    actual_status=$?
    set -e
    [ "$actual_status" -eq "$expected_status" ] || {
        printf '%s\n' "A management command returned an unexpected status." >&2
        exit 1
    }
    if grep -F "Unhandled exception" "$output" >/dev/null \
        || grep -F "dumped core" "$output" >/dev/null; then
        printf '%s\n' "A management command caused an unhandled process failure." >&2
        exit 1
    fi
}

run_failure 2 env -u MK8EMAIL_CONFIG_FILE \
    /usr/bin/dotnet "$cli_dll" --not-a-command
grep -F "Use one valid management command." "$output" >/dev/null

run_failure 1 env -u MK8EMAIL_CONFIG_FILE \
    /usr/bin/dotnet "$cli_dll" --healthcheck
grep -F "Set MK8EMAIL_CONFIG_FILE" "$output" >/dev/null

run_failure 2 runuser -u nobody -- /usr/local/sbin/mk8email --healthcheck
grep -F "Run this command as root." "$output" >/dev/null

run_failure 2 /usr/local/sbin/mk8email --serve-experimental-protocols
grep -F "Use a supported production management command." "$output" >/dev/null

run_failure 2 /usr/local/sbin/mk8email --set-domain-active mk8n.com not-a-state
grep -F "The domain state must be true or false." "$output" >/dev/null

run_failure 2 /usr/local/sbin/mk8email --revoke-app-password admin@mk8n.com not-an-id
grep -F "The application password identifier is not valid." "$output" >/dev/null

timeout 30s /usr/local/sbin/mk8email --healthcheck

printf '%s\n' "Management command validation and production configuration tests passed."
